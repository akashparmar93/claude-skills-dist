#!/usr/bin/env python3
"""skillctl - single source of truth for Claude Code skills across devices.

The repo containing this script is the source of truth. skills.json declares
which skills should exist, where each came from, and which upstream commit it
is pinned to. Each device symlinks ~/.claude/skills/<name> into skills/<name>
here, so `git pull` is the whole update mechanism.

  skillctl status            where this device stands (local, no network)
  skillctl sync              make ~/.claude/skills match the manifest
  skillctl update            every skill and mod to upstream latest; commit, push
  skillctl remove <name>     a skill or mod off every device; commit, push
  skillctl approve <mod-id>  approve the command a mod is waiting on
  skillctl check             which vendored skills have upstream updates
  skillctl diff  <name>      what changed upstream since the pin
  skillctl vendor <name>     pull upstream in and re-pin
  skillctl adopt  <name>     bring an unmanaged local skill into the repo

Python 3.13+, standard library only.
"""

import argparse
import copy
import fnmatch
import hashlib
import http.client
import io
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.request

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MANIFEST = os.path.join(REPO, "skills.json")
SKILLS_SRC = os.path.join(REPO, "skills")
INSTALL_DIR = os.path.expanduser("~/.claude/skills")
# Deliberately NOT under INSTALL_DIR: Claude Code loads every directory there as
# a skill, so a backup kept alongside its original would be loaded as a second,
# near-identical skill — doubling context and making activation ambiguous.
BACKUP_DIR = os.path.expanduser("~/.claude/skillctl-backups")
IGNORE = {".DS_Store", ".git", "__pycache__", ".in_use"}

# A Claude Code cloud container is not a device we own. Its ~/.claude/skills
# always holds directories we did not put there — `synced/` from account-level
# skill sync, plus whatever ships in the base image. Those are not candidates
# for `adopt`, so counting them as unmanaged would make `status` exit non-zero
# on every cloud session and destroy the "exit 0 = in sync" contract.
IS_CLOUD = os.environ.get("CLAUDE_CODE_REMOTE") == "true"

# The Claude desktop app writes the same account-level sync into this one
# directory on a Mac (first seen 2026-10-09). It is the app's, not ours, so it
# is platform there too — otherwise the login check warns in every new shell.
DESKTOP_SYNC = "synced"

# What `skillctl publish` copies into the public mirror. Everything else stays
# private: OPEN.md and SETUP.md carry device names, a private repo name and an
# email address, and eval/ and setup-shell have no role on a cloud box.
PUBLISH_PATHS = ["skills", "skills.json", "CLAUDE.md", "hooks",
                 "bin/skillctl", "bin/cloud-setup.sh", "bin/cloud-sync.sh"]

# ---------------------------------------------------------------- terminal ---

_TTY = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def c(code, s):
    return "\033[%sm%s\033[0m" % (code, s) if _TTY else s


def green(s):
    return c("32", s)


def red(s):
    return c("31", s)


def yellow(s):
    return c("33", s)


def dim(s):
    return c("2", s)


def bold(s):
    return c("1", s)


def die(msg):
    print(red("error: ") + msg, file=sys.stderr)
    sys.exit(1)


# ---------------------------------------------------------------- manifest ---


def load_manifest():
    if not os.path.exists(MANIFEST):
        die("no skills.json at %s (run: skillctl init)" % MANIFEST)
    with open(MANIFEST) as f:
        return json.load(f)


def save_manifest(m):
    with open(MANIFEST, "w") as f:
        json.dump(m, f, indent=2, sort_keys=True)
        f.write("\n")


# ------------------------------------------------------------------ hashing ---


def git_blob_sha(path):
    """Git's own blob hash, so we can compare against GitHub trees for free."""
    with open(path, "rb") as f:
        data = f.read()
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def walk_files(root):
    """Relative path -> absolute path, for every real file under root."""
    out = {}
    if not os.path.isdir(root):
        return out
    for base, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if d not in IGNORE]
        for fn in files:
            if fn in IGNORE:
                continue
            ap = os.path.join(base, fn)
            out[os.path.relpath(ap, root)] = ap
    return out


def tree_hash(root):
    """Content hash of a directory: stable across machines, ignores mtime."""
    h = hashlib.sha256()
    files = walk_files(root)
    for rel in sorted(files):
        h.update(rel.encode() + b"\0")
        with open(files[rel], "rb") as f:
            h.update(f.read())
        h.update(b"\0")
    return "sha256:" + h.hexdigest()


def matches(rel, include, exclude):
    if exclude and any(fnmatch.fnmatch(rel, p) for p in exclude):
        return False
    if include:
        return any(fnmatch.fnmatch(rel, p) for p in include)
    return True


# ------------------------------------------------------------------ network ---


def api_token():
    """Env first, then the gh CLI keyring. Never written to disk by skillctl."""
    tok = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
    if tok:
        return tok
    try:
        out = subprocess.run(["gh", "auth", "token"], capture_output=True, text=True, timeout=10)
        return out.stdout.strip() or None
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None


def _read_with_retry(req, attempts=3):
    """A read cut short (IncompleteRead) or a dropped connection is retried;
    an HTTPError is GitHub's answer and is raised at once. A URLError, such as
    a missing CA file, is raised at once too: retrying cannot fix it."""
    for i in range(attempts):
        try:
            return urllib.request.urlopen(req, timeout=60).read()
        except (http.client.IncompleteRead, ConnectionError) as e:
            if i == attempts - 1:
                raise
            print(dim("  %s from GitHub; retrying in %ds (attempt %d of %d)"
                      % (type(e).__name__, 2 ** i, i + 2, attempts)), file=sys.stderr)
            time.sleep(2 ** i)


def gh(url):
    req = urllib.request.Request(url, headers={"User-Agent": "skillctl", "Accept": "application/vnd.github+json"})
    tok = api_token()
    if tok:
        req.add_header("Authorization", "Bearer " + tok)
    try:
        return _read_with_retry(req)
    except urllib.error.HTTPError as e:
        if e.code in (403, 429):
            if IS_CLOUD:
                # Not a rate limit. A cloud session's GitHub API access is
                # restricted to the repos attached to that session, so any
                # upstream request 403s no matter how long you wait — and the
                # injected GITHUB_TOKEN is the literal string "proxy-injected".
                die("upstream GitHub API is not reachable from a Claude Code cloud "
                    "session.\n  API access is scoped to this session's own repos, so "
                    "checking third-party\n  upstreams 403s regardless of waiting. Run "
                    "`check` / `diff` / `vendor` on a\n  real device instead.\n  %s" % url)
            hint = ("You are unauthenticated (60 requests/hr). Install and run `gh auth login`, "
                    "or export GITHUB_TOKEN, to get 5000/hr."
                    if not api_token() else
                    "Authenticated but still limited — wait for the window to reset.")
            die("GitHub rate limit hit. %s\n  %s" % (hint, url))
        raise


def resolve_ref(repo, ref):
    """ref (branch/tag/sha) -> concrete commit sha."""
    data = json.loads(gh("https://api.github.com/repos/%s/commits/%s" % (repo, ref)))
    return data["sha"]


_tree_cache = {}


def upstream_tree(repo, sha):
    """{relpath: git blob sha} for an entire repo at a commit."""
    key = (repo, sha)
    if key not in _tree_cache:
        data = json.loads(gh("https://api.github.com/repos/%s/git/trees/%s?recursive=1" % (repo, sha)))
        if data.get("truncated"):
            die("tree for %s@%s is truncated; repo too large for the API path" % (repo, sha[:8]))
        _tree_cache[key] = {t["path"]: t["sha"] for t in data.get("tree", []) if t["type"] == "blob"}
    return _tree_cache[key]


def upstream_files(origin, sha):
    """{relpath (relative to the skill root): blob sha} honouring path/include/exclude."""
    tree = upstream_tree(origin["repo"], sha)
    sub = origin.get("path", "").strip("/")
    prefix = sub + "/" if sub else ""
    include, exclude = origin.get("include"), origin.get("exclude")
    out = {}
    for path, blob in tree.items():
        if not path.startswith(prefix):
            continue
        rel = path[len(prefix):]
        if not rel or not matches(rel, include, exclude):
            continue
        out[rel] = blob
    return out


_tarball_cache = {}


def fetch_subtree(origin, sha, dest):
    """Download repo tarball at sha and extract the skill's files into dest."""
    repo = origin["repo"]
    if (repo, sha) not in _tarball_cache:
        url = "https://codeload.github.com/%s/tar.gz/%s" % (repo, sha)
        req = urllib.request.Request(url, headers={"User-Agent": "skillctl"})
        _tarball_cache[(repo, sha)] = urllib.request.urlopen(req, timeout=180).read()
    raw = _tarball_cache[(repo, sha)]

    sub = origin.get("path", "").strip("/")
    include, exclude = origin.get("include"), origin.get("exclude")
    wanted = set(upstream_files(origin, sha))

    if os.path.isdir(dest):
        shutil.rmtree(dest)
    os.makedirs(dest, exist_ok=True)

    with tarfile.open(fileobj=io.BytesIO(raw), mode="r:gz") as tf:
        for member in tf.getmembers():
            if not member.isfile():
                continue
            parts = member.name.split("/", 1)  # strip the <repo>-<sha>/ prefix
            if len(parts) < 2:
                continue
            path = parts[1]
            if sub:
                if not path.startswith(sub + "/"):
                    continue
                rel = path[len(sub) + 1:]
            else:
                rel = path
            if rel not in wanted:
                continue
            target = os.path.join(dest, rel)
            os.makedirs(os.path.dirname(target), exist_ok=True)
            src = tf.extractfile(member)
            with open(target, "wb") as f:
                shutil.copyfileobj(src, f)
            os.chmod(target, member.mode & 0o777 or 0o644)
    return len(wanted)


# ------------------------------------------------------------------- git ---


def git(*args, **kw):
    try:
        out = subprocess.run(
            ["git", "-C", REPO] + list(args),
            capture_output=True, text=True, check=kw.get("check", False),
        )
        return out.stdout.strip()
    except FileNotFoundError:
        return ""


STATE_FILE = os.path.expanduser("~/.claude/skillctl-state.json")


def load_state():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(**kw):
    """Merge keys into the device state. A value of None retires its key.

    State is merged rather than rewritten, so a field that falls out of use
    would otherwise sit in the file at whatever value it last held, and read as
    current by anyone opening it.
    """
    st = load_state()
    for k, v in kw.items():
        if v is None:
            st.pop(k, None)
        else:
            st[k] = v
    try:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        with open(STATE_FILE, "w") as f:
            json.dump(st, f, indent=2)
    except OSError:
        pass


def now_iso():
    import datetime
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat()


def age_seconds(iso):
    """Seconds since an ISO timestamp, or None if absent or unparseable."""
    if not iso:
        return None
    import datetime
    try:
        then = datetime.datetime.fromisoformat(iso)
    except ValueError:
        return None
    if then.tzinfo is None:
        then = then.replace(tzinfo=datetime.timezone.utc)
    return (datetime.datetime.now(datetime.timezone.utc) - then).total_seconds()


def age_of(iso):
    """Human age of an ISO timestamp, or None."""
    secs = age_seconds(iso)
    if secs is None:
        return None
    if secs < 3600:
        return "%dm ago" % (secs // 60)
    if secs < 86400:
        return "%dh ago" % (secs // 3600)
    return "%dd ago" % (secs // 86400)


# Upstream moves on its own schedule, so a check only speaks for the tree for
# so long. Past this, `status` reports the age instead of asserting a verdict.
CHECK_AGE_LIMIT = 7 * 86400


def pin_fingerprint(manifest):
    """Digest of every input `check` compares against upstream: each vendored
    skill's pin and content, and each mod's recorded version.

    Keyed on the pins and vendored content rather than on HEAD: most commits
    here are docs and CI, and invalidating the record on each of them would cry
    wolf until the line got ignored -- which is the failure it exists to stop.
    """
    import hashlib
    parts = []
    for name in sorted(manifest.get("skills", {})):
        spec = manifest["skills"][name] or {}
        origin = spec.get("origin")
        if not origin:
            continue  # no upstream, so `check` never compares it
        parts.append("\t".join((
            name,
            origin.get("repo", ""),
            origin.get("ref", "main"),
            origin.get("path", ""),
            (spec.get("pin") or {}).get("commit", ""),
            spec.get("hash", ""),
        )))
    # `check` counts mod updates into its record too, so an `update` that
    # moves only a mod must supersede it. No mods leaves the digest as it was.
    for mod_id, spec in sorted(manifest_mods(manifest).items()):
        version = spec.get("version")
        parts.append("mod\t%s\t%s" % (mod_id, version if isinstance(version, str) else ""))
    return hashlib.sha256("\n".join(parts).encode("utf-8")).hexdigest()[:16]


def check_freshness(state, manifest, age_limit=CHECK_AGE_LIMIT):
    """How much of the recorded `check` result can still be claimed.

    The result is a fact about the tree that was checked. `status` used to
    print it as a fact about the current tree, so a pull or a vendor left it
    confidently wrong in whichever direction the pins had moved.

    Returns (verdict, stale_count):
      "never"       nothing recorded
      "superseded"  pins or vendored content moved since; re-check
      "aged"        still describes these pins, but old enough that upstream
                    may have moved underneath it
      "fresh"       believable as printed
    """
    if not state.get("last_check"):
        return "never", 0
    stale = state.get("last_check_stale_count", 0)
    # A record from a skillctl that predated fingerprints has none. Claiming
    # freshness from it is the original bug, so treat it as needing a re-check.
    if state.get("last_check_pins") != pin_fingerprint(manifest):
        return "superseded", stale
    secs = age_seconds(state["last_check"])
    if secs is None or secs > age_limit:
        return "superseded" if secs is None else "aged", stale
    return "fresh", stale


def repo_state(strict=False):
    """strict: behind and ahead are None when there is no upstream to count
    against (none configured, detached HEAD), rather than reading as level."""
    head = git("rev-parse", "--short", "HEAD") or "?"
    branch = git("rev-parse", "--abbrev-ref", "HEAD") or "?"
    dirty = bool(git("status", "--porcelain"))
    counts = git("rev-list", "--left-right", "--count", "@{upstream}...HEAD")
    behind = ahead = None if strict else 0
    if counts and "\t" in counts:
        b, a = counts.split("\t")[:2]
        behind, ahead = int(b), int(a)
    return {"head": head, "branch": branch, "dirty": dirty, "behind": behind, "ahead": ahead}


# ------------------------------------------------------------- install state ---


def install_state(name):
    """How this device currently has <name> installed."""
    path = os.path.join(INSTALL_DIR, name)
    src = os.path.join(SKILLS_SRC, name)
    if not os.path.lexists(path):
        return "missing", path
    if os.path.islink(path):
        target = os.path.realpath(path)
        if target == os.path.realpath(src):
            return "linked", path
        return "wrong-link", target
    return "unmanaged-copy", path


# ------------------------------------------------------------------ commands ---


def print_mod_rows(m, states, installed):
    """The `mods` block of `status`, one row per mod in `mod_states`."""
    listed = manifest_mods(m)
    print(bold("mods"))
    w = max(len(i) for i in states) if states else 10
    for mod_id, state in states.items():
        version = (listed.get(mod_id) or {}).get("version")
        here = (installed.get(mod_id) or {}).get("version")
        text = {
            "installed": green("ok"),
            "missing": red("missing — not installed, run: skillctl sync"),
            "removed": yellow("removed — uninstalled here; the next sync removes it "
                              "everywhere (reinstall it to keep it)"),
            "behind": red("behind — not at the recorded version, run: skillctl sync"),
            "differs": yellow("differs — here %s, recorded %s (skillctl update records "
                              "the latest)" % (here or "?", version or "?")),
            "waiting": yellow("waiting — skillctl approve %s" % mod_id),
            "disabled": dim("off — disabled here"),
            "unlisted": dim("unlisted — the next sync uninstalls it"),
            "extra": dim("extra — installed by hand, not listed"),
        }[state]
        print("  %-*s  %s%s" % (w, mod_id, text,
                                dim("  " + version) if isinstance(version, str) else ""))


def cmd_status(args):
    m = load_manifest()
    skills = m["skills"]

    # Without a fetch, "behind" is measured against a possibly stale
    # remote-tracking ref — the device would claim to be current when it is not.
    fetched = False
    if not args.no_fetch:
        fetched = subprocess.run(
            ["git", "-C", REPO, "fetch", "--quiet", "origin"],
            capture_output=True, timeout=30).returncode == 0
    st = repo_state()

    print(bold("source of truth  ") + REPO)
    sync_note = ""
    if st["behind"]:
        sync_note = red("  %d commit(s) behind — run: git pull" % st["behind"])
    elif st["ahead"]:
        sync_note = yellow("  %d commit(s) ahead — unpushed" % st["ahead"])
    elif not fetched:
        sync_note = dim("  (not fetched — comparison may be stale)")
    print(bold("repo             ") + "%s @ %s%s%s" % (
        st["branch"], st["head"],
        yellow(" (uncommitted changes)") if st["dirty"] else "",
        sync_note))
    print(bold("install dir      ") + INSTALL_DIR)

    cmd_state = claude_md_state()
    print(bold("CLAUDE.md        ") + {
        "installed": green("linked — skill routing active"),
        "missing": red("NOT INSTALLED — skills load but nothing routes to them; run: skillctl sync"),
        "foreign": yellow("exists but differs from the repo — merge, or sync --force"),
        "absent-in-repo": dim("none in repo"),
    }[cmd_state])

    hstates = hook_states()
    hline = hooks_line(hstates)
    hreasons = hook_reasons(hstates)
    print(bold("hooks            ") + (
        red(hline) if hreasons
        else green(hline) if hstates and all(v == "installed" for v in hstates.values())
        else yellow(hline)))

    state = load_state()
    verdict, stale = check_freshness(state, m)
    checked = age_of(state.get("last_check"))
    if verdict == "never":
        print(bold("upstreams        ") + dim("never checked — run: skillctl check"))
    elif verdict == "superseded":
        # Reporting the old count here is what made this line wrong in both
        # directions: "all current" after a pull brought pins nothing had
        # checked, and "3 had updates" after those three were vendored.
        print(bold("upstreams        ") + yellow(
            "pins moved since the last check%s — re-run: skillctl check"
            % (" (%s)" % checked if checked else "")))
    elif verdict == "aged":
        print(bold("upstreams        ") + "checked %s%s" % (
            checked,
            red(" — %d skill(s) or mod(s) had updates" % stale) if stale
            else yellow(" — none then; upstream may have moved since")))
    else:
        print(bold("upstreams        ") + "checked %s%s" % (
            checked,
            red(" — %d skill(s) or mod(s) had updates" % stale) if stale
            else green(" — all current")))
    # Written by hooks/session-sync.py. No record is no line: a machine that
    # has never run the hook is not at fault.
    autosync = state.get("autosync")
    autosync_failed = False
    if isinstance(autosync, dict) and isinstance(autosync.get("result"), str):
        result = autosync["result"]
        autosync_failed = result.startswith("failed:")
        age = age_of(autosync.get("at"))
        text = result + (", " + age if age else "")
        print(bold("autosync         ") + (
            red(text) if autosync_failed
            else yellow(text) if result.startswith("skipped:") else text))
    print()

    rows, tally = [], {}
    for name in sorted(skills):
        spec = skills[name]
        state, detail = install_state(name)
        src = os.path.join(SKILLS_SRC, name)
        if not os.path.isdir(src):
            state = "absent-in-repo"
        elif state == "unmanaged-copy":
            # A real directory instead of a symlink: is it at least identical?
            state = "copy-in-sync" if tree_hash(src) == tree_hash(detail) else "copy-drifted"
        tally[state] = tally.get(state, 0) + 1
        origin = spec.get("origin")
        rows.append((name, state, origin, spec.get("pin", {})))

    copy_mode = load_state().get("install_mode") == "copy"
    mark = {
        "linked": (green("ok"), ""),
        "copy-in-sync": ((green("ok"), "copied (this platform has no symlinks)") if copy_mode
                         else (yellow("copy"), "real dir, contents match — run sync to link")),
        "copy-drifted": (red("drift"), "real dir, contents differ from repo"),
        "missing": (red("missing"), "not installed — run sync"),
        "wrong-link": (red("bad-link"), "symlink points elsewhere"),
        "absent-in-repo": (red("no-src"), "declared in manifest but missing from skills/"),
    }
    w = max(len(n) for n in skills) if skills else 10
    for name, state, origin, pin in rows:
        sym, note = mark.get(state, (state, ""))
        upstream = origin["repo"] if origin else "local"
        pinned = pin.get("commit", "")[:7]
        print("  %-9s %-*s  %-38s %s" % (
            sym, w, name,
            dim(upstream + ("@" + pinned if pinned else "")),
            dim(note)))

    # No mods anywhere: claude may not be on PATH, so do not even ask it.
    mods_in_play = bool(manifest_mods(m) or recorded_mods())
    mstates = {}
    if mods_in_play:
        installed = installed_mods(timeout=STATUS_PLUGIN_TIMEOUT)
        mstates = None if installed is None else mod_states(m, installed)
        print()
        if mstates is None:
            print(bold("mods  ") + dim("not checked (claude plugin list failed)"))
        else:
            print_mod_rows(m, mstates, installed)

    print()
    platform, unmanaged = extra_dirs(skills)
    if platform:
        print(dim("  platform:  ") + dim(", ".join(platform) + "  (provided by the cloud image / account sync)"))
    if unmanaged:
        print(yellow("  unmanaged: ") + ", ".join(unmanaged) + dim("  (run: skillctl adopt <name>)"))

    warn_legacy_backups()

    # On a platform without symlinks, an in-sync copy is a correct install.
    healthy_states = {"linked", "copy-in-sync"} if copy_mode else {"linked"}
    ok = sum(v for k, v in tally.items() if k in healthy_states)
    total = len(skills)
    reasons = ["%d %s" % (v, k) for k, v in sorted(tally.items()) if k not in healthy_states]
    cmd = claude_md_state()
    if cmd == "missing":
        reasons.append("CLAUDE.md not installed")
    elif cmd == "foreign":
        reasons.append("CLAUDE.md differs from repo")
    reasons.extend(hreasons)
    for state, reason in (("missing", "mods missing"), ("behind", "mods behind"),
                          ("waiting", "mods waiting for approval")):
        if state in (mstates or {}).values():
            reasons.append(reason)
    if st["behind"]:
        reasons.append("repo %d behind" % st["behind"])
    if autosync_failed:
        reasons.append("autosync failed")
    if unmanaged:
        reasons.append("%d unmanaged" % len(unmanaged))
    stale = legacy_backups()
    if stale:
        # Not cosmetic: each one is loaded as a duplicate skill, so this device
        # is not in a good state until they are gone.
        reasons.append("%d stale backup(s) in skills dir" % len(stale))
    healthy = not reasons
    verb = "copied" if copy_mode else "linked"
    print(bold("verdict          ") + (
        green("in sync — %d/%d skills %s at %s" % (ok, total, verb, st["head"])) if healthy
        else yellow("%d/%d %s; %s" % (ok, total, verb, ", ".join(reasons)))))
    if args.json:
        print(json.dumps({"repo": st, "skills": {n: s for n, s, _, _ in rows}, "unmanaged": unmanaged,
                          "platform": platform, "hooks": hstates, "mods": mstates}, indent=2))
    return 0 if healthy else 1


def install_one(src, dst):
    """Symlink if the platform allows it, else copy.

    Windows refuses symlinks unless Developer Mode is on or the shell is
    elevated, so a plain failure here would make the tool unusable there.
    """
    try:
        os.symlink(src, dst)
        return "link"
    except (OSError, NotImplementedError, AttributeError):
        if os.path.isdir(src):
            shutil.copytree(src, dst, ignore=shutil.ignore_patterns(*IGNORE))
        else:
            shutil.copy2(src, dst)
        return "copy"


def _remove(path):
    """Delete a file, symlink or directory."""
    if os.path.islink(path) or os.path.isfile(path):
        os.unlink(path)
    elif os.path.isdir(path):
        shutil.rmtree(path)


def backup_dest(name):
    """Where a displaced install is kept, outside INSTALL_DIR — see BACKUP_DIR.

    One backup per name: a second forced sync replaces the first, matching the
    previous behaviour. The repo is the real safety net; this is a convenience
    for the window between syncing and confirming the result.
    """
    os.makedirs(BACKUP_DIR, exist_ok=True)
    dest = os.path.join(BACKUP_DIR, name + ".bak-skillctl")
    if os.path.lexists(dest):
        _remove(dest)
    return dest


def legacy_backups():
    """Backups written into INSTALL_DIR by versions before BACKUP_DIR existed."""
    if not os.path.isdir(INSTALL_DIR):
        return []
    return [d for d in sorted(os.listdir(INSTALL_DIR)) if d.endswith(".bak-skillctl")]


def extra_dirs(managed):
    """Install-dir entries the manifest does not name, as (platform, unmanaged).

    Platform is everything in a cloud container, and DESKTOP_SYNC anywhere.
    Only unmanaged entries are candidates for `adopt` or count against status.
    """
    if not os.path.isdir(INSTALL_DIR):
        return [], []
    extra = [d for d in sorted(os.listdir(INSTALL_DIR))
             if d not in managed and not d.startswith(".") and not d.endswith(".bak-skillctl")]
    if IS_CLOUD:
        return extra, []
    return ([d for d in extra if d == DESKTOP_SYNC],
            [d for d in extra if d != DESKTOP_SYNC])


def warn_legacy_backups():
    """Loudly, because Claude Code is loading each of these as a real skill."""
    stale = legacy_backups()
    if not stale:
        return
    print()
    print(yellow("  warn    ") + "%d stale backup(s) inside %s" % (len(stale), INSTALL_DIR))
    print(dim("          Claude Code loads every directory there as a skill, so these are"))
    print(dim("          being loaded as duplicates of the skills they back up. Remove with:"))
    print(dim("          rm -rf %s/*.bak-skillctl" % INSTALL_DIR))


CLAUDE_MD_SRC = os.path.join(REPO, "CLAUDE.md")
CLAUDE_MD_DST = os.path.expanduser("~/.claude/CLAUDE.md")


def claude_md_state():
    """installed | missing | foreign | absent-in-repo"""
    if not os.path.isfile(CLAUDE_MD_SRC):
        return "absent-in-repo"
    if not os.path.lexists(CLAUDE_MD_DST):
        return "missing"
    if os.path.islink(CLAUDE_MD_DST):
        return ("installed" if os.path.realpath(CLAUDE_MD_DST) == os.path.realpath(CLAUDE_MD_SRC)
                else "foreign")
    with open(CLAUDE_MD_SRC, "rb") as a, open(CLAUDE_MD_DST, "rb") as b:
        return "installed" if a.read() == b.read() else "foreign"


def sync_claude_md(args):
    """Link the repo's CLAUDE.md into ~/.claude. Routing lives there, so a device
    without it gets the skills but not the instructions to use them."""
    state = claude_md_state()
    if state in ("absent-in-repo", "installed"):
        return 0
    if state == "foreign" and not args.force:
        print(yellow("  CLAUDE.md ") + "exists and differs from the repo — left alone. "
              "Merge it, or re-run with --force")
        return 0
    if args.dry_run:
        print(green("  link    ") + "CLAUDE.md")
        return 1
    if os.path.lexists(CLAUDE_MD_DST):
        if os.path.islink(CLAUDE_MD_DST):
            os.unlink(CLAUDE_MD_DST)
        else:
            backup = backup_dest("CLAUDE.md")
            shutil.move(CLAUDE_MD_DST, backup)
            print(dim("          kept previous CLAUDE.md -> %s" % backup))
    os.makedirs(os.path.dirname(CLAUDE_MD_DST), exist_ok=True)
    mode = install_one(CLAUDE_MD_SRC, CLAUDE_MD_DST)
    print(green("  link    " if mode == "link" else "  copy    ") + "CLAUDE.md")
    return 1


HOOKS = {"UserPromptSubmit": "size-warn.py", "Stop": "context-warn.py",
         "SessionStart": "session-sync.py"}
HOOKS_SRC = os.path.join(REPO, "hooks")
SETTINGS = os.path.expanduser("~/.claude/settings.json")


def hook_command(script):
    """`python3 <path> || true`. Claude Code runs hook commands through a shell
    and treats exit 2 as blocking; python3 exits 2 when the script is gone (a
    deleted worktree, an old branch, a moved repo), which would block every
    prompt. `|| true` makes that impossible and still passes stdout through."""
    return "python3 " + shlex.quote(os.path.join(HOOKS_SRC, script)) + " || true"


def is_our_hook(command, script):
    """True for `python3 <dir>/hooks/<script>`, with or without a trailing
    `|| true`, at any checkout, and nothing else: a lookalike such as
    `python3 /x/size-warn.py` is somebody else's hook. The bare form is what
    sync wrote before `|| true`; recognising it lets sync upgrade it in place."""
    try:
        parts = shlex.split(command)
    except (ValueError, AttributeError):
        return False
    if parts[2:] == ["||", "true"]:
        parts = parts[:2]
    if len(parts) != 2 or parts[0] != "python3":
        return False
    path = parts[1]
    return (os.path.basename(path) == script
            and os.path.basename(os.path.dirname(path)) == "hooks")


def _our_entries(settings, event, script):
    """Every hook entry under settings.hooks[event] that is ours."""
    for group in settings.get("hooks", {}).get(event, []):
        if not isinstance(group, dict):
            continue
        inner = group.get("hooks", [])
        if not isinstance(inner, list):
            continue
        for h in inner:
            if isinstance(h, dict) and is_our_hook(h.get("command"), script):
                yield h


def hooks_present(settings):
    """The scripts that have an entry of ours in settings, at whatever path."""
    return {script for event, script in HOOKS.items()
            if any(True for _ in _our_entries(settings, event, script))}


def merge_hooks(settings, skip=frozenset()):
    """Add our hooks to settings in place; True if anything changed.

    Same rule as bin/cloud-setup.sh: every other key and hook is kept, ours is
    appended as its own group. An entry of ours at another path is rewritten in
    place even when its script is in skip -- that is a moved checkout, not a
    removal. Event types and groups we do not own are left exactly as found.
    """
    changed = False
    for event, script in HOOKS.items():
        cmd = hook_command(script)
        found = False
        for h in _our_entries(settings, event, script):
            found = True
            if h["command"] != cmd:
                h["command"] = cmd
                changed = True
        if found or script in skip:
            continue
        settings.setdefault("hooks", {}).setdefault(event, []).append(
            {"hooks": [{"type": "command", "command": cmd}]})
        changed = True
    return changed


def read_settings():
    """{} when the file is absent, None when it cannot be used as it stands.

    That covers a file that does not parse and one whose `hooks` is not the
    object-of-lists shape Claude Code defines: either way, merging into it would
    mean guessing, and sync must never overwrite what it cannot read.
    """
    try:
        with open(SETTINGS, encoding="utf-8") as f:
            settings = json.load(f)
    except FileNotFoundError:
        return {}
    except (OSError, ValueError):
        return None
    if not isinstance(settings, dict):
        return None
    hooks = settings.get("hooks", {})
    if not isinstance(hooks, dict):
        return None
    for event in HOOKS:
        if not isinstance(hooks.get(event, []), list):
            return None
    return settings


def recorded_hooks():
    """The scripts state says sync installed, as a set. A malformed record reads
    as none: a string must not become a set of its characters."""
    recorded = load_state().get("hooks_installed", [])
    if not isinstance(recorded, list):
        return set()
    return {s for s in recorded if isinstance(s, str)}


def hook_states():
    """script -> installed | missing | elsewhere | removed; None if settings is unusable.

    elsewhere: an entry of ours exists but none runs this checkout's script.
    installed: an entry runs exactly this checkout's command (wins over a stale
    duplicate, since the hook does fire). removed: no entry, but sync installed
    it once -- the owner deleted it, which is their call.
    """
    settings = read_settings()
    if settings is None:
        return None
    recorded = recorded_hooks()
    states = {}
    for event, script in HOOKS.items():
        commands = [h.get("command") for h in _our_entries(settings, event, script)]
        if hook_command(script) in commands:
            states[script] = "installed"
        elif commands:
            states[script] = "elsewhere"
        elif script in recorded:
            states[script] = "removed"
        else:
            states[script] = "missing"
    return states


def hooks_line(states):
    if states is None:
        return "settings.json does not parse — not checked"
    if all(v == "installed" for v in states.values()):
        return "installed (%d/%d)" % (len(states), len(states))
    parts = []
    for state, label in (("missing", "missing: %s"),
                         ("elsewhere", "points elsewhere: %s"),
                         ("removed", "removed by you: %s (sync --force restores)")):
        scripts = [s for s, v in states.items() if v == state]
        if scripts:
            parts.append(label % ", ".join(scripts))
    return "; ".join(parts)


def hook_reasons(states):
    """Verdict reasons. A removed hook is the owner's choice, never a fault."""
    if states is None:
        return ["settings.json unreadable"]
    reasons = []
    if "missing" in states.values():
        reasons.append("hooks missing")
    if "elsewhere" in states.values():
        reasons.append("hooks point elsewhere")
    return reasons


def in_linked_worktree(path):
    """True if path is inside a linked git worktree (its git dir and common git
    dir differ). False for a main checkout, a plain clone, or when git is
    missing or fails: this check must never stand in the way of a sync."""
    def rev_parse(flag):
        r = subprocess.run(["git", "-C", path, "rev-parse", flag],
                           capture_output=True, text=True, timeout=10)
        out = r.stdout.strip()
        if r.returncode != 0 or not out:
            return None
        return os.path.realpath(os.path.join(path, out))
    try:
        git_dir, common = rev_parse("--git-dir"), rev_parse("--git-common-dir")
    except (OSError, subprocess.SubprocessError):
        return False
    return bool(git_dir and common) and git_dir != common


def sync_hooks(args):
    """Register our hooks (HOOKS) in ~/.claude/settings.json.

    A hook the owner deletes by hand stays deleted: state remembers what sync
    has installed, and a recorded script with no entry left is not re-added
    unless --force. Cloud sessions run `sync --force`, so there it always is.

    Not from a linked worktree unless --force: the registered path would vanish
    when the worktree is removed.
    """
    if not args.force and in_linked_worktree(REPO):
        print(yellow("  hooks   ") + "not registered from a worktree (%s) — run sync "
              "from the main checkout, or --force" % REPO)
        return 0
    settings = read_settings()
    if settings is None:
        print(red("  hooks   ") + "settings.json does not parse — hooks not registered; "
              "fix it and re-run sync")
        return 0
    recorded = recorded_hooks()
    present = hooks_present(settings)
    skip = set() if args.force else recorded - present
    for script in sorted(skip):
        print(dim("  removed ") + "%s — deleted by hand, left out (sync --force restores it)"
              % script)
    before = copy.deepcopy(settings)
    changed = merge_hooks(settings, skip)
    if changed:
        for event, script in HOOKS.items():
            if before.get("hooks", {}).get(event) != settings.get("hooks", {}).get(event):
                print(green("  hook    ") + "%s -> %s" % (event, script))
        if not args.dry_run:
            # Serialize and encode before opening: opening for write truncates, so
            # an encoding error (a lone surrogate loads fine) must surface first.
            try:
                data = (json.dumps(settings, indent=2, ensure_ascii=False) + "\n").encode("utf-8")
            except ValueError as e:
                print(red("  hooks   ") + "cannot write settings.json (%s) — left untouched" % e)
                return 0
            try:
                os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
                # Write in place, not a rename: keeps a symlinked file a symlink.
                with open(SETTINGS, "wb") as f:
                    f.write(data)
            except OSError as e:
                print(red("  hooks   ") + "could not write %s: %s" % (SETTINGS, e))
                return 0
    if not args.dry_run:
        now = recorded | hooks_present(settings)
        if now != recorded:
            save_state(hooks_installed=sorted(now))
    return 1 if changed else 0


# --------------------------------------------------------------------- mods ---
# A mod is a Claude Code plugin, named everywhere by its "name@marketplace" id.
# skills.json records them as {"mods": {id: {"source": "owner/repo", "version": ...}}}.

PLUGIN_TIMEOUT = 120  # seconds
# `status` runs at every login shell (bin/setup-shell); a hung `claude` must
# not hold the prompt. A list that times out reads as "not checked".
STATUS_PLUGIN_TIMEOUT = 10


def manifest_mods(m):
    mods = m.get("mods", {})
    if not isinstance(mods, dict):
        return {}
    return {k: v for k, v in mods.items() if isinstance(v, dict)}


def _parse_json_output(text):
    """The JSON in `claude plugin ... --json` stdout, or None.

    Normally the whole of stdout; `marketplace add` prints progress first and
    the JSON as the last line, so fall back to the last line that parses.
    """
    try:
        return json.loads(text)
    except ValueError:
        pass
    for line in reversed(text.splitlines()):
        line = line.strip()
        if line.startswith(("{", "[")):
            try:
                return json.loads(line)
            except ValueError:
                continue
    return None


def plugin_cli(*args, timeout=PLUGIN_TIMEOUT):
    """Run `claude plugin <args> --json`. Returns (returncode, data, stderr).

    stdin is closed so a command approval prompt can never hang a sync.
    """
    try:
        r = subprocess.run(["claude", "plugin", *args, "--json"], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        return 127, None, "claude not on PATH"
    except subprocess.TimeoutExpired:
        return 124, None, "timed out after %ds" % timeout
    except (OSError, UnicodeDecodeError) as e:  # not runnable, or output not UTF-8
        return 127, None, str(e)
    return r.returncode, _parse_json_output(r.stdout or ""), (r.stderr or "").strip()


def installed_mods(timeout=PLUGIN_TIMEOUT):
    """{id: {"version": str | None, "enabled": bool}} from `plugin list`, or
    None when the call fails or the output is not a list of {"id": str, ...}.

    Only user-scope installs count (an entry with no scope is taken as one):
    sync installs there, and a project or local install is present only from
    its own directory, so it must read as neither here nor gone."""
    rc, data, _ = plugin_cli("list", timeout=timeout)
    if rc != 0 or not isinstance(data, list):
        return None
    out = {}
    for item in data:
        if not isinstance(item, dict) or not isinstance(item.get("id"), str):
            return None
        if item.get("scope", "user") != "user":
            continue
        version = item.get("version")
        out[item["id"]] = {"version": version if isinstance(version, str) else None,
                           "enabled": item.get("enabled") is True}
    return out


def marketplace_name(mod_id):
    return mod_id.partition("@")[2]


def recorded_mods():
    """The mods state says sync installed, as a set. A malformed record reads
    as none, as for recorded_hooks."""
    recorded = load_state().get("mods_installed", [])
    if not isinstance(recorded, list):
        return set()
    return {s for s in recorded if isinstance(s, str)}


def removed_here(mod_id):
    """True for a mod sync installed on this Mac (it is recorded) that is no
    longer installed: the owner uninstalled it, and the next sync removes it
    everywhere. Never in cloud, where a fresh container has nothing and sync
    reinstalls instead. The caller has checked it is not installed."""
    return not IS_CLOUD and mod_id in recorded_mods()


def waiting_mods():
    """{id: sha256 of the command} for mods whose install or update stopped to
    ask the owner to approve a command. A malformed record reads as none."""
    waiting = load_state().get("mods_waiting", {})
    if not isinstance(waiting, dict):
        return {}
    return {k: v for k, v in waiting.items() if isinstance(k, str) and isinstance(v, str)}


def update_tried_mods():
    """{id: recorded version} for mods sync ran `plugin update` on at that
    recorded version and found elsewhere afterwards. Not tried again until
    skills.json records another version. A malformed record reads as none."""
    tried = load_state().get("mods_update_tried", {})
    if not isinstance(tried, dict):
        return {}
    return {k: v for k, v in tried.items() if isinstance(k, str) and isinstance(v, str)}


def mod_states(m, installed=None):
    """How this device stands on each mod, from `plugin list` and local state
    only (no network), or None when `plugin list` cannot be read. `installed`
    is installed_mods() as the caller already read it; read here when None.

    {id: state}, state one of:
      installed  listed, here, at the version skills.json records
      behind     listed, here and enabled, at a different version from the one
                 recorded
      differs    behind, but sync already ran `plugin update` at this recorded
                 version and it did not get there (update_tried_mods): not a
                 fault, and not retried until the recorded version changes
      disabled   listed, here, turned off (the owner's call): wins over behind,
                 because nothing automatic touches a disabled mod
      missing    listed and not here
      removed    listed, not here, and recorded as installed by sync on this
                 Mac: uninstalled here, so the next sync removes it everywhere
                 (see removed_here); not a fault
      waiting    listed, and its install or update stopped for an approval;
                 wins over missing and behind, which it explains
      unlisted   here, not listed, and recorded as installed by sync: dropped
                 from skills.json elsewhere, so the next sync uninstalls it
      extra      here, not listed and not recorded: installed by hand
    """
    if installed is None:
        installed = installed_mods()
    if installed is None:
        return None
    listed = manifest_mods(m)
    waiting = waiting_mods()
    tried = update_tried_mods()
    recorded = recorded_mods()
    states = {}
    for mod_id in sorted(set(listed) | set(installed)):
        if mod_id not in listed:
            states[mod_id] = "unlisted" if mod_id in recorded else "extra"
            continue
        want = listed[mod_id].get("version")
        here = installed.get(mod_id)
        if here is None:
            # As sync decides it: a removal here wins over a pending approval.
            states[mod_id] = ("removed" if removed_here(mod_id)
                              else "waiting" if mod_id in waiting else "missing")
        elif not here["enabled"]:
            states[mod_id] = "disabled"  # sync leaves it alone, so not a fault
        elif isinstance(want, str) and here["version"] != want:
            states[mod_id] = ("waiting" if mod_id in waiting
                              else "differs" if tried.get(mod_id) == want else "behind")
        else:
            states[mod_id] = "installed"
    return states


def approval_sha(data):
    """The sha256 of the command a `plugin install/update` result asks the owner
    to approve, or None. Keyed only on shownCommand.sha256 (the shape is from
    help, not captured), never on an outcome string."""
    if not isinstance(data, dict):
        return None
    shown = data.get("shownCommand")
    if isinstance(shown, dict) and isinstance(shown.get("sha256"), str):
        return shown["sha256"]
    return None


def machine_name():
    try:
        r = subprocess.run(["scutil", "--get", "ComputerName"], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, timeout=10)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return socket.gethostname()


GIT_TIMEOUT = 60  # seconds, for commit_and_push


def commit_and_push(paths, message):
    """git add <paths>, commit only those paths, push. False, saying why, on any
    failure; a commit already made stays. Never in cloud."""
    if IS_CLOUD:
        print(red("  push      ") + "refused in cloud — commits only come from a Mac")
        return False
    # This runs unattended at session start: never wait on a credential prompt.
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    for step, argv in (("add", ["add", "--"] + paths),
                       ("commit", ["commit", "-q", "-m", message, "--"] + paths),
                       ("push", ["push", "-q"])):
        try:
            r = subprocess.run(["git", "-C", REPO] + argv, stdin=subprocess.DEVNULL, env=env,
                               capture_output=True, text=True, timeout=GIT_TIMEOUT)
            ok, why = r.returncode == 0, (r.stderr or r.stdout or "").strip()
        except subprocess.TimeoutExpired:
            ok, why = False, "timed out after %ds" % GIT_TIMEOUT
        except OSError as e:
            ok, why = False, str(e)
        if not ok:
            # git's first line names the cause; the hints after it do not.
            lines = [ln.strip() for ln in why.splitlines()
                     if ln.strip() and not ln.startswith("hint:")]
            kept = " — the commit is kept; push it by hand" if step == "push" else ""
            print(red("  %-9s " % step) + "%s failed: %s%s"
                  % (step, lines[0] if lines else "no output", kept))
            return False
    return True


def _mod_line(label, colour, text):
    print(colour("  %-9s " % label) + text)


def _mod_result(mod_id, verb, rc, data, err, waiting):
    """Read an install/update result. True on success; an approval request is
    recorded in `waiting`, never accepted."""
    sha = approval_sha(data)
    if sha is not None:
        waiting[mod_id] = sha
        _mod_line("waiting", yellow, "%s — needs your approval: skillctl approve %s"
                  % (mod_id, mod_id))
        return False
    if rc != 0:
        _mod_line("error", red, "%s — %s failed (exit %d): %s"
                  % (mod_id, verb, rc, err or "no detail"))
        return False
    waiting.pop(mod_id, None)
    return True


def _stdin_is_tty():
    return sys.stdin is not None and sys.stdin.isatty()


def _set_waiting(mod_id, sha):
    """Record (sha) or clear (None) a mod's pending approval in device state."""
    waiting = waiting_mods()
    if sha is None:
        if mod_id not in waiting:
            return
        del waiting[mod_id]
    else:
        waiting[mod_id] = sha
    save_state(mods_waiting=waiting or None)


def approve_mod(mod_id, op, ask=input, accept=None):
    """Run `claude plugin <op> <mod_id>` (op: install or update). If it stops
    for a command approval, show the command, then re-run with
    --accept-command only for that exact command: when `accept` is its
    sha256, or when the owner answers y at a terminal. With no terminal and
    no matching `accept`, print how to approve it and leave it waiting.
    Never passes -y. True when the op succeeded; a declined or pending
    approval is recorded in mods_waiting."""
    rc, data, err = plugin_cli(op, mod_id)
    sha = approval_sha(data)
    if sha is not None:
        shown = data["shownCommand"]
        command = shown.get("command")
        print(bold("%s wants to run a command:" % mod_id))
        print("    " + (command if isinstance(command, str)
                        else json.dumps(shown, sort_keys=True)))
        if accept is not None and accept != sha:
            _mod_line("refused", red, "%s — the command has changed since %s… was approved "
                      "(it is now %s); review it and approve again" % (mod_id, accept[:12], sha))
            _set_waiting(mod_id, sha)
            return False
        if accept is None:
            if not _stdin_is_tty():
                print(dim("    sha256 %s" % sha))
                _mod_line("waiting", yellow, "%s — approve with: skillctl approve %s --accept %s"
                          % (mod_id, mod_id, sha))
                _set_waiting(mod_id, sha)
                return False
            try:
                answer = ask("Run this command? [y/N] ")
            except EOFError:
                answer = ""
            if answer.strip().lower() not in ("y", "yes"):
                _mod_line("waiting", yellow, "%s — not approved; left as it is" % mod_id)
                _set_waiting(mod_id, sha)
                return False
        rc, data, err = plugin_cli(op, mod_id, "--accept-command", sha)
        again = approval_sha(data)
        if again is not None:
            _mod_line("waiting", yellow, "%s — asked for a different command (%s); "
                      "nothing run — approve again" % (mod_id, again))
            _set_waiting(mod_id, again)
            return False
    if rc != 0:
        _mod_line("error", red, "%s — %s failed (exit %d): %s"
                  % (mod_id, op, rc, err or "no detail"))
        return False
    _set_waiting(mod_id, None)
    return True


def cmd_approve(args):
    """Approve the command a listed mod is waiting on, and install or update it."""
    listed = manifest_mods(load_manifest())
    waiting = waiting_mods()
    if any(k not in listed for k in waiting):
        save_state(mods_waiting={k: v for k, v in waiting.items() if k in listed} or None)
    if args.id not in listed:
        die("%s is not a mod in skills.json" % args.id)
    installed = installed_mods()
    if installed is None:
        die("`claude plugin list` failed — cannot tell whether %s is installed" % args.id)
    op = "update" if args.id in installed else "install"
    if not approve_mod(args.id, op, accept=args.accept):
        return 1
    if op == "install":  # as sync records its own installs
        save_state(mods_installed=sorted(recorded_mods() | {args.id}))
    _mod_line("installed" if op == "install" else "updated", green, args.id)
    return 0


def _removal_hold(rs):
    """Why a removed-here mod must not be propagated yet, or None."""
    if rs["dirty"]:
        return "commit your changes and re-run sync"
    # A commit anywhere but main never reaches the other Macs, and switching
    # back to main would then reinstall the mod.
    if rs["branch"] != "main":
        return "on branch %s, not main; switch to main and re-run sync" % rs["branch"]
    if rs["behind"] is None or rs["ahead"] is None:
        return "no upstream to push to; set one for main and re-run sync"
    if rs["behind"] and rs["ahead"]:
        return "repo has diverged from its upstream; reconcile and re-run sync"
    if rs["behind"]:
        return "repo is behind its upstream; pull and re-run sync"
    if rs["ahead"]:
        # Our push would publish the owner's unpushed commits along with it.
        return "repo has unpushed local commits; push them and re-run sync"
    return None


def sync_mods(args, m):
    """Make this device's mods match skills.json. Returns the number of changes.

    Fails closed: if `claude plugin list` cannot be read, nothing at all is done.
    A listed mod this device installed once and no longer has was uninstalled
    here by the owner; on a Mac that removal is propagated (dropped from
    skills.json, committed, pushed). In cloud a fresh container has nothing, so
    there it is reinstalled instead. Never passes -y or --accept-command.
    """
    listed = manifest_mods(m)
    recorded = recorded_mods()
    if not listed and not recorded:
        return 0  # no mods anywhere: claude may not even be on PATH
    installed = installed_mods()
    if installed is None:
        _mod_line("mods", red, "`claude plugin list` failed — mods not synced")
        return 0
    waiting_before = waiting_mods()
    waiting = dict(waiting_before)
    tried_before = update_tried_mods()
    tried = {k: v for k, v in tried_before.items() if k in listed}
    record = set(recorded)
    changes = 0
    marketplaces = None  # names, read once when first needed
    refreshed = {}  # marketplace -> whether `marketplace update` succeeded
    updating = []   # ids `plugin update` ran on, read back below
    removed_here = []

    def ensure_marketplace(mod_id, spec):
        nonlocal marketplaces
        name = marketplace_name(mod_id)
        if not name:
            _mod_line("error", red, "%s — not a name@marketplace id" % mod_id)
            return False
        if marketplaces is None:
            rc, data, err = plugin_cli("marketplace", "list")
            if rc != 0 or not isinstance(data, list):
                _mod_line("error", red, "%s — `claude plugin marketplace list` failed: %s"
                          % (mod_id, err or "unreadable output"))
                return False
            marketplaces = {d.get("name") for d in data if isinstance(d, dict)}
        if name in marketplaces:
            return True
        source = spec.get("source")
        if not isinstance(source, str) or not source:
            _mod_line("error", red, "%s — marketplace %s missing and no source to add it from"
                      % (mod_id, name))
            return False
        _mod_line("market", green, "%s <- %s" % (name, source))
        if not args.dry_run:
            rc, _, err = plugin_cli("marketplace", "add", source)
            if rc != 0:
                _mod_line("error", red, "%s — adding marketplace %s failed: %s"
                          % (mod_id, source, err or "exit %d" % rc))
                return False
        marketplaces.add(name)
        return True

    for mod_id in sorted(listed):
        spec = listed[mod_id]
        want = spec.get("version") if isinstance(spec.get("version"), str) else None
        if mod_id in installed:
            # A disabled mod is still installed; enabling it is the owner's call,
            # and `plugin update` could re-enable it, so leave it entirely alone.
            record.add(mod_id)
            if not installed[mod_id]["enabled"]:
                continue
            have = installed[mod_id]["version"]
            if not want or have == want:
                waiting.pop(mod_id, None)
                tried.pop(mod_id, None)
                continue
            if mod_id in waiting:
                _mod_line("waiting", yellow, "%s — needs your approval: skillctl approve %s"
                          % (mod_id, mod_id))
                continue
            if tried.get(mod_id) == want:
                # Tried at this recorded version and it did not get there (a
                # downgrade, or ahead by Claude Code's own update): retrying at
                # every session start would only fail again.
                _mod_line("differs", yellow, "%s — here %s, recorded %s; `plugin update` "
                          "could not reach it (skillctl update records the latest)"
                          % (mod_id, have or "?", want))
                continue
            _mod_line("update", green, "%s  %s -> %s" % (mod_id, have or "?", want))
            if args.dry_run:
                changes += 1
                continue
            market = marketplace_name(mod_id)
            if not market:
                _mod_line("error", red, "%s — not a name@marketplace id" % mod_id)
                continue
            if market not in refreshed:
                # A stale local marketplace cache cannot offer the recorded version.
                rc, _, err = plugin_cli("marketplace", "update", market)
                refreshed[market] = rc == 0
                if rc != 0:
                    _mod_line("error", red, "marketplace %s — update failed (exit %d): %s"
                              % (market, rc, err or "no detail"))
            if not refreshed[market]:
                continue
            rc, data, err = plugin_cli("update", mod_id)
            _mod_result(mod_id, "update", rc, data, err, waiting)
            if mod_id not in waiting:  # it ran: whether it got there is read back below
                updating.append(mod_id)
            continue
        if mod_id in recorded and not IS_CLOUD:
            removed_here.append(mod_id)
            continue
        if mod_id in waiting:
            _mod_line("waiting", yellow, "%s — needs your approval: skillctl approve %s"
                      % (mod_id, mod_id))
            continue
        if not ensure_marketplace(mod_id, spec):
            continue
        _mod_line("install", green, mod_id)
        if args.dry_run:
            changes += 1
            continue
        rc, data, err = plugin_cli("install", mod_id)
        if _mod_result(mod_id, "install", rc, data, err, waiting):
            record.add(mod_id)
            changes += 1

    if updating:
        # Exit 0 is not proof: `plugin update` cannot downgrade, and does
        # nothing for a version its marketplace does not offer.
        after = installed_mods()
        for mod_id in updating:
            want = listed[mod_id]["version"]
            now = ((after or {}).get(mod_id) or {}).get("version")
            if after is None:
                _mod_line("error", red, "%s — `claude plugin list` failed after the update; "
                          "it is checked again next sync" % mod_id)
            elif now == want:
                tried.pop(mod_id, None)
                changes += 1
            else:
                tried[mod_id] = want
                _mod_line("differs", yellow, "%s — `plugin update` left it at %s, not %s; "
                          "not retried until skills.json records another version "
                          "(skillctl update records the latest)" % (mod_id, now or "?", want))

    for mod_id in sorted(recorded - set(listed)):
        waiting.pop(mod_id, None)
        if mod_id not in installed:
            record.discard(mod_id)  # gone here and from the list: nothing left to do
            continue
        _mod_line("uninstall", yellow, mod_id)
        changes += 1
        if args.dry_run:
            continue
        rc, _, err = plugin_cli("uninstall", mod_id)
        if rc == 0:
            record.discard(mod_id)
        else:
            _mod_line("error", red, "%s — uninstall failed (exit %d): %s"
                      % (mod_id, rc, err or "no detail"))

    if removed_here:
        changes += propagate_removals(args, m, removed_here, record)

    if not args.dry_run:
        if record != recorded:
            save_state(mods_installed=sorted(record))
        if waiting != waiting_before:
            save_state(mods_waiting=waiting or None)
        if tried != tried_before:
            save_state(mods_update_tried=tried or None)
    return changes


# The pause before `plugin list` is read again to confirm a removal: one read
# that came back empty while Claude Code was starting up must not remove a mod
# from every Mac.
REMOVAL_RECHECK_SECONDS = 2


def propagate_removals(args, m, ids, record):
    """Drop mods the owner uninstalled here from skills.json, commit and push.
    Held unless the repo is clean, on main and level with its upstream. Returns
    changes made: none if the commit could not be made, since the edit is then
    undone."""
    if len(ids) > 1:
        # One `plugin list` that came back empty but successful would otherwise
        # remove every mod from every Mac. Deliberate removals have `remove`.
        _mod_line("held", yellow, "%s — several mods vanished at once — if you meant it, "
                  "run skillctl remove <id> for each" % ", ".join(ids))
        return 0
    if args.dry_run:
        for mod_id in ids:
            _mod_line("remove", yellow, "%s — uninstalled here; would drop it from "
                      "skills.json, commit and push" % mod_id)
        return len(ids)
    hold = _removal_hold(repo_state(strict=True))
    if hold:
        for mod_id in ids:
            _mod_line("held", yellow, "%s — uninstalled here; %s" % (mod_id, hold))
        return 0
    # The several-at-once guard above never fires with one mod listed, and an
    # empty list is no reason to hold (the owner may uninstall their only mod).
    time.sleep(REMOVAL_RECHECK_SECONDS)
    again = installed_mods()
    if again is None or any(mod_id in again for mod_id in ids):
        for mod_id in ids:
            _mod_line("held", yellow, "%s — `claude plugin list` disagreed with itself "
                      "about it; not removed — re-run sync" % mod_id)
        return 0
    for mod_id in ids:
        _mod_line("remove", yellow, "%s — uninstalled here; dropping it from skills.json"
                  % mod_id)
        del m["mods"][mod_id]
    save_manifest(m)
    message = "Remove mod %s (uninstalled on %s)" % (ids[0], machine_name())
    if not commit_and_push(["skills.json"], message) and git("status", "--porcelain",
                                                             "--", "skills.json"):
        # add or commit failed, so the edit is ours alone (the tree was clean):
        # undo it in index and worktree. The mods stay recorded, so the
        # removal is tried again next sync.
        git("checkout", "HEAD", "--", "skills.json")
        if git("status", "--porcelain", "--", "skills.json"):
            _mod_line("error", red, "could not restore skills.json — "
                      "`git checkout HEAD -- skills.json` by hand")
        else:
            _mod_line("restored", yellow, "restored skills.json from HEAD — the removal "
                      "was not committed; it is retried next sync")
        return 0
    record.difference_update(ids)
    return len(ids)


def prune_removed_links(managed, dry_run=False):
    """Unlink every symlink in INSTALL_DIR that points into SKILLS_SRC under a
    name the manifest no longer lists: a skill removed on another device. The
    target is read, not followed, so a link whose skill directory is already
    gone counts. Real directories and links to anywhere else are never touched.
    Returns the names; with dry_run, only reports them."""
    if not os.path.isdir(INSTALL_DIR):
        return []
    src = os.path.realpath(SKILLS_SRC)
    pruned = []
    for name in sorted(os.listdir(INSTALL_DIR)):
        if name in managed:
            continue
        path = os.path.join(INSTALL_DIR, name)
        if not os.path.islink(path):
            continue
        target = os.path.normpath(os.path.join(INSTALL_DIR, os.readlink(path)))
        if os.path.realpath(os.path.dirname(target)) != src:
            continue
        print(yellow("  unlink  ") + "%s (removed from the manifest)" % name)
        if not dry_run:
            os.unlink(path)
        pruned.append(name)
    return pruned


def _restore_paths(paths):
    """Undo an uncommitted removal in index and worktree. The tree was clean
    when it began (_removal_hold), so what differs in `paths` is ours alone."""
    git("checkout", "HEAD", "--", *paths)
    joined = " ".join(paths)
    if git("status", "--porcelain", "--", *paths):
        print(red("  error     ") + "could not restore %s — `git checkout HEAD -- %s` by hand"
              % (joined, joined))
    else:
        print(yellow("  restored  ") + "%s from HEAD — nothing was removed" % joined)


def cmd_remove(args):
    """Remove a skill or mod everywhere: delete its manifest entry (and, for a
    skill, its directory), commit and push. Other devices drop it at their next
    sync."""
    m = load_manifest()
    name = args.name
    if name in m.get("skills", {}):
        kind = "skill"
    elif name in manifest_mods(m):
        kind = "mod"
    else:
        die("%s is not a skill or a mod in skills.json" % name)
    if IS_CLOUD:
        die("remove commits and pushes, which cloud sessions never do; run it on a Mac")
    # The hold is only as good as the last fetch: behind a remote that moved
    # since, the push would fail after the mod was already uninstalled here.
    fetched, why = fetch_upstream()
    if not fetched:
        die("not removing %s: git fetch failed: %s" % (name, why))
    # The same hold as for a removal sync propagates: ahead included, since the
    # push would publish the owner's other unpushed commits along with this one.
    hold = _removal_hold(repo_state(strict=True))
    if hold:
        die("not removing %s: %s" % (name, hold))

    src = os.path.join(SKILLS_SRC, name)
    link = os.path.join(INSTALL_DIR, name)
    paths = ["skills.json"]
    if kind == "skill" and os.path.lexists(src):
        paths.append("skills/" + name)
    if args.dry_run:
        what = ("drop it from skills.json, delete skills/%s, unlink %s" % (name, link)
                if kind == "skill" else "uninstall it here, drop it from skills.json")
        print(yellow("  remove  ") + "%s %s: %s, commit and push" % (kind, name, what))
        return 0

    if kind == "mod":
        # Before skills.json is touched, so a failure leaves everything as it was.
        rc, data, err = plugin_cli("uninstall", name)
        not_installed = isinstance(data, dict) and data.get("failureCode") == "not_installed"
        if rc != 0 and not not_installed:
            die("`claude plugin uninstall %s` failed (exit %d): %s — skills.json left alone"
                % (name, rc, err or "no detail"))
        del m["mods"][name]
    else:
        del m["skills"][name]
    save_manifest(m)
    if kind == "skill":
        _remove(src)

    pushed = commit_and_push(paths, "Remove %s %s" % (kind, name))
    if not pushed and git("status", "--porcelain", "--", *paths):
        # add or commit failed: put the repo back as it was.
        _restore_paths(paths)
        print(dim("          run skillctl remove %s again once that is fixed" % name))
        return 1
    # Past here the commit is made; a failed push was reported and is the
    # owner's to finish, but the removal stands, so finish it here too.
    if kind == "skill":
        if os.path.islink(link):
            os.unlink(link)
        elif os.path.exists(link):
            print(dim("          %s is a real directory, not a link; left in place" % link))
    else:
        recorded = recorded_mods()
        if name in recorded:
            save_state(mods_installed=sorted(recorded - {name}))
        waiting = waiting_mods()
        if name in waiting:
            del waiting[name]
            save_state(mods_waiting=waiting or None)
    print(green("removed ") + "%s %s" % (kind, name))
    return 0 if pushed else 1


def cmd_sync(args):
    m = load_manifest()
    os.makedirs(INSTALL_DIR, exist_ok=True)
    changed = 0
    modes = set()
    copy_device = load_state().get("install_mode") == "copy"
    if not copy_device:  # there the install dirs are real copies, not ours to unlink
        changed += len(prune_removed_links(set(m["skills"]), args.dry_run))
    for name in sorted(m["skills"]):
        src = os.path.join(SKILLS_SRC, name)
        dst = os.path.join(INSTALL_DIR, name)
        if not os.path.isdir(src):
            print(red("  skip    ") + "%s (missing from skills/)" % name)
            continue
        state, _ = install_state(name)
        if state == "linked":
            continue
        if state == "unmanaged-copy" and copy_device and tree_hash(src) == tree_hash(dst):
            continue  # copy-mode device, already an exact mirror
        if state in ("unmanaged-copy", "wrong-link"):
            # On a copy-mode device the installed dirs are our own mirror, so a
            # difference just means the repo moved ahead — replace it freely.
            # install_mode is only set after a successful sync, so a first run
            # still guards whatever content was already on the machine.
            if state == "unmanaged-copy" and copy_device and tree_hash(src) != tree_hash(dst):
                shutil.rmtree(dst)
                modes.add(install_one(src, dst))
                print(green("  refresh ") + name)
                changed += 1
                continue
            if state == "unmanaged-copy" and tree_hash(src) != tree_hash(dst) and not args.force:
                print(red("  drift   ") + "%s — real dir differs from repo. "
                      "Inspect with `skillctl adopt %s --dry-run`, then re-run with --force"
                      % (name, name))
                continue
            if args.dry_run:
                print(yellow("  replace ") + name)
                changed += 1
                continue
            if os.path.islink(dst):
                os.unlink(dst)
            elif tree_hash(src) == tree_hash(dst):
                # Byte-identical to the repo — nothing to preserve.
                shutil.rmtree(dst)
            else:
                backup = backup_dest(name)
                shutil.move(dst, backup)
                print(dim("          kept previous copy -> %s" % backup))
        if args.dry_run:
            print(green("  link    ") + name)
        else:
            mode = install_one(src, dst)
            modes.add(mode)
            print(green("  link    " if mode == "link" else "  copy    ") + name)
        changed += 1

    changed += sync_claude_md(args)
    changed += sync_hooks(args)
    changed += sync_mods(args, m)

    platform, unmanaged = extra_dirs(m["skills"])
    for name in platform:
        print(dim("  platform  ") + "%s (cloud image / account sync — left alone)" % name)
    for name in unmanaged:
        print(yellow("  extra   ") + "%s — not in manifest (skillctl adopt %s, or delete it)" % (name, name))

    warn_legacy_backups()

    if modes and not args.dry_run:
        mode = "copy" if "copy" in modes else "link"
        save_state(install_mode=mode)
        if mode == "copy":
            print()
            print(yellow("  note: ") + "this platform refused symlinks, so skills were COPIED.")
            print(dim("        On Windows, enable Developer Mode (or run elevated) for symlinks."))
            print(dim("        Until then `git pull` is not enough — re-run `skillctl sync` after each pull."))

    print()
    print(green("nothing to do — already in sync") if not changed
          else bold("%d change(s)%s" % (changed, " (dry run)" if args.dry_run else "")))
    return 0


def _check_one(name, spec):
    """Compare vendored copy against upstream. Returns a result dict."""
    origin = spec.get("origin")
    src = os.path.join(SKILLS_SRC, name)
    if not origin:
        return {"name": name, "state": "local"}
    pin = spec.get("pin", {}).get("commit")
    ref = origin.get("ref", "main")
    try:
        latest = resolve_ref(origin["repo"], ref)
        up = upstream_files(origin, latest)
    except Exception as e:
        return {"name": name, "state": "error", "detail": "%s: %s" % (type(e).__name__, e)}

    local = {rel: git_blob_sha(ap) for rel, ap in walk_files(src).items()}
    modified = sorted(k for k in local if k in up and local[k] != up[k])
    added_up = sorted(k for k in up if k not in local)
    only_local = sorted(k for k in local if k not in up)

    same_commit = (pin == latest)
    identical = not (modified or added_up or only_local)
    state = "current" if identical else ("behind" if not same_commit else "modified")
    return {
        "name": name, "state": state, "repo": origin["repo"], "ref": ref,
        "pin": pin, "latest": latest, "modified": modified,
        "added_upstream": added_up, "only_local": only_local,
    }


def _check_mods(m):
    """Compare each listed mod's marketplace-latest with the version skills.json
    records, printing a line per mod. Returns (updates, errors).

    The latest version comes from `plugin install <id>` on a mod already
    installed here: that exits 0 and reports installedVersion and
    availableVersion without changing anything (`plugin list --available`
    carries no version for claude-community). A mod not installed here has
    nothing to compare and is neither an update nor an error.
    """
    listed = manifest_mods(m)
    if not listed:
        return 0, 0  # no mods anywhere: claude may not even be on PATH
    updates = errors = 0

    def line(label, colour, mod_id, text):
        print("  %-9s %-32s %s" % (colour(label), mod_id, text))

    refreshed = {}  # marketplace -> failure text, or None when it refreshed
    for market in sorted({marketplace_name(i) for i in listed} - {""}):
        rc, _, err = plugin_cli("marketplace", "update", market)
        refreshed[market] = None if rc == 0 else "marketplace %s update failed (exit %d): %s" % (
            market, rc, err or "no detail")
    installed = installed_mods()
    for mod_id in sorted(listed):
        market = marketplace_name(mod_id)
        if not market:
            line("error", red, mod_id, "not a name@marketplace id")
            errors += 1
            continue
        if installed is None:
            line("error", red, mod_id, "`claude plugin list` failed")
            errors += 1
            continue
        if mod_id not in installed:
            line("skipped", yellow, mod_id, dim(
                "uninstalled here — the next sync removes it everywhere "
                "(reinstall it to keep it)" if removed_here(mod_id)
                else "not installed here — run sync"))
            continue
        if not installed[mod_id]["enabled"]:
            # `plugin install` on a disabled mod re-enables it.
            line("skipped", yellow, mod_id, dim("disabled here — not checked"))
            continue
        if refreshed[market]:
            line("error", red, mod_id, refreshed[market])
            errors += 1
            continue
        rc, data, err = plugin_cli("install", mod_id)
        available = data.get("availableVersion") if isinstance(data, dict) else None
        if approval_sha(data) is not None:
            line("error", red, mod_id, "asked for a command approval; nothing run")
            errors += 1
            continue
        if rc != 0 or not isinstance(available, str):
            line("error", red, mod_id, "no available version (exit %d): %s"
                 % (rc, err or "unreadable output"))
            errors += 1
            continue
        recorded = listed[mod_id].get("version")
        if not isinstance(recorded, str):
            recorded = data.get("installedVersion")
        if not isinstance(recorded, str):
            recorded = installed[mod_id]["version"]
        if recorded == available:
            line("current", green, mod_id, dim(available))
        else:
            line("UPDATE", red, mod_id, "%s -> %s" % (recorded or "?", available))
            updates += 1
    return updates, errors


def cmd_check(args):
    m = load_manifest()
    names = [args.name] if args.name else sorted(m["skills"])
    stale = errors = 0
    print(bold("checking %d skill(s) against upstream…" % len(names)))
    print()
    for name in names:
        spec = m["skills"].get(name) or die("unknown skill: %s" % name)
        r = _check_one(name, spec)
        if r["state"] == "local":
            print("  %-9s %-32s %s" % (dim("local"), name, dim("no upstream — owned by this repo")))
            continue
        if r["state"] == "error":
            print("  %-9s %-32s %s" % (red("error"), name, r["detail"]))
            errors += 1
            continue
        moved = r["pin"] != r["latest"]
        if r["state"] == "current":
            note = "up to date" + ("" if not moved else " (content identical; pin lags)")
            print("  %-9s %-32s %s" % (green("current"), name, dim(note)))
            continue
        stale += 1
        counts = []
        if r["modified"]:
            counts.append("%d changed" % len(r["modified"]))
        if r["added_upstream"]:
            counts.append("%d new upstream" % len(r["added_upstream"]))
        if r["only_local"]:
            counts.append("%d only local" % len(r["only_local"]))
        label = red("UPDATE") if r["state"] == "behind" else yellow("MODIFIED")
        print("  %-9s %-32s %s" % (label, name, ", ".join(counts)))
        print("            %s" % dim("%s  %s -> %s" % (
            r["repo"], r["pin"][:7] if r["pin"] else "unpinned", r["latest"][:7])))
        for f in (r["modified"] + r["added_upstream"])[:args.files]:
            tag = "changed" if f in r["modified"] else "new"
            print("              %s %s" % (dim("·"), "%s %s" % (f, dim("[%s]" % tag))))
        rest = len(r["modified"]) + len(r["added_upstream"]) - args.files
        if rest > 0:
            print(dim("              … and %d more" % rest))
    mod_stale = mod_errors = 0
    if not args.name:  # a named check is one skill; mods are part of a full sweep
        mod_stale, mod_errors = _check_mods(m)
    print()
    if stale:
        print(bold("%d skill(s) have upstream changes" % stale)
              + dim("   review: skillctl diff <name>   adopt: skillctl update"))
    elif not errors:
        print(green("all vendored skills are current"))
    if mod_stale:
        print(bold("%d mod(s) have updates" % mod_stale)
              + dim("   adopt: skillctl update"))
    if errors or mod_errors:
        # An errored lookup proves nothing either way, so this sweep must not
        # replace the last record: saving it would claim those skills current.
        if errors:
            print(red("%d skill(s) could not be checked" % errors))
        if mod_errors:
            print(red("%d mod(s) could not be checked" % mod_errors))
        print(dim("previous check record kept"))
        return 1
    if not args.name:  # only a full sweep is a meaningful freshness record
        save_state(last_check=now_iso(), last_check_stale_count=stale + mod_stale,
                   last_check_pins=pin_fingerprint(m),
                   # Written and never read until it was removed; retired here
                   # so devices that ran the old version drop it too. Safe to
                   # delete this line once both Macs have checked once.
                   last_check_head=None)
    return (stale or mod_stale) and 2 or 0


def cmd_diff(args):
    m = load_manifest()
    spec = m["skills"].get(args.name) or die("unknown skill: %s" % args.name)
    origin = spec.get("origin")
    if not origin:
        die("%s has no upstream (it is owned by this repo)" % args.name)
    latest = resolve_ref(origin["repo"], origin.get("ref", "main"))
    tmp = tempfile.mkdtemp(prefix="skillctl-diff-")
    try:
        fetch_subtree(origin, latest, os.path.join(tmp, args.name))
        src = os.path.join(SKILLS_SRC, args.name)
        print(bold("%s: vendored (a) vs %s@%s (b)" % (args.name, origin["repo"], latest[:7])))
        print()
        rc = subprocess.run(
            ["git", "diff", "--no-index", "--stat" if args.stat else "--patch",
             src, os.path.join(tmp, args.name)],
        ).returncode
        if rc == 0:
            print(green("identical — nothing to adopt"))
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return 0


class UpstreamGone(Exception):
    """Upstream has no files where the skill's origin points."""


def vendor_one(name, spec, dry_run=False):
    """Bring skills/<name> to the latest commit of its origin's ref and re-pin
    `spec` in place. Returns {"old", "new", "changed", "files"}: the pinned
    commit before and after, whether the vendored content changed, and how
    many files were fetched.

    The fetch lands in a temp directory first, so a failed download or an
    upstream path that no longer exists (UpstreamGone) leaves the skill and
    its pin as they were. dry_run only resolves the ref: nothing is written,
    "changed" says whether the pin would move, and "files" is None.
    """
    origin = spec["origin"]
    ref = origin.get("ref", "main")
    old = (spec.get("pin") or {}).get("commit")
    latest = resolve_ref(origin["repo"], ref)
    if dry_run:
        return {"old": old, "new": latest, "changed": old != latest, "files": None}
    dest = os.path.join(SKILLS_SRC, name)
    tmp = tempfile.mkdtemp(prefix="skillctl-vendor-")
    try:
        fetched = os.path.join(tmp, name)
        n = fetch_subtree(origin, latest, fetched)
        if not n:
            raise UpstreamGone("nothing at %s:%s@%s" % (
                origin["repo"], origin.get("path", "") or "/", latest[:7]))
        before = tree_hash(dest)
        if os.path.isdir(dest):
            shutil.rmtree(dest)
        shutil.move(fetched, dest)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    after = tree_hash(dest)
    spec["pin"] = {"commit": latest, "ref": ref}
    spec["hash"] = after
    return {"old": old, "new": latest, "changed": before != after, "files": n}


def cmd_vendor(args):
    m = load_manifest()
    names = sorted(m["skills"]) if args.all else [args.name]
    if not names or names == [None]:
        die("give a skill name or --all")
    updated = skipped = 0
    for name in names:
        spec = m["skills"].get(name) or die("unknown skill: %s" % name)
        origin = spec.get("origin")
        if not origin:
            continue
        try:
            r = vendor_one(name, spec, dry_run=args.dry_run)
        except UpstreamGone as e:
            # Carry on: the skills vendored before this one still need their
            # new pins saved below, or their files and skills.json disagree.
            print("  %-9s %-32s %s" % (red("skipped"), name, "%s — left as it is" % e))
            skipped += 1
            continue
        if args.dry_run:
            print(yellow("  would vendor ") + "%s <- %s@%s" % (name, origin["repo"], r["new"][:7]))
            continue
        if not r["changed"]:
            print("  %-9s %-32s %s" % (dim("nochange"), name, dim("%d files" % r["files"])))
        else:
            updated += 1
            print("  %-9s %-32s %s" % (green("vendored"), name,
                                       dim("%d files @ %s" % (r["files"], r["new"][:7]))))
    if not args.dry_run:
        save_manifest(m)
        print()
        print(bold("%d skill(s) updated." % updated) + dim("  Review with `git -C %s diff`, then commit and push." % REPO))
        if updated:
            print()
            print(dim("linting vendored content…"))
            if cmd_lint(args) != 0:
                print(red("lint failed") + " — an upstream change broke a skill's frontmatter. "
                      "Fix before committing.")
                return 1
    return 1 if skipped else 0


def _update_hold(rs):
    """Why `update` must not run on this checkout, or None. Being behind is
    fine: update pulls first."""
    if rs["dirty"]:
        return "uncommitted changes; commit or discard them first"
    if rs["branch"] != "main":
        return ("on branch %s, not main; an update committed here never reaches "
                "the other Macs" % rs["branch"])
    if rs["behind"] is None or rs["ahead"] is None:
        return "main has no upstream to pull from or push to; set one first"
    if rs["behind"] and rs["ahead"]:
        return "main has diverged from its upstream; reconcile it first"
    if rs["ahead"]:
        # The update's push would publish them along with it.
        return "main has %d unpushed commit(s); push them first" % rs["ahead"]
    return None


def _git_bounded(*args):
    """git <args> in REPO, bounded by GIT_TIMEOUT and never waiting on a
    credential prompt. Returns (ok, git's first line of complaint)."""
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    try:
        r = subprocess.run(["git", "-C", REPO] + list(args),
                           stdin=subprocess.DEVNULL, env=env,
                           capture_output=True, text=True, timeout=GIT_TIMEOUT)
    except subprocess.TimeoutExpired:
        return False, "timed out after %ds" % GIT_TIMEOUT
    except OSError as e:
        return False, str(e)
    if r.returncode == 0:
        return True, ""
    lines = [ln.strip() for ln in (r.stderr or r.stdout or "").splitlines()
             if ln.strip() and not ln.startswith("hint:")]
    return False, lines[0] if lines else "exit %d" % r.returncode


def pull_ff_only():
    """`git pull --ff-only`: (ok, git's first line of complaint)."""
    return _git_bounded("pull", "--ff-only", "-q")


def fetch_upstream():
    """`git fetch`, so the remote-tracking refs are current: (ok, why)."""
    return _git_bounded("fetch", "--quiet")


SUITE_TIMEOUT = 600  # seconds; a hung suite is a failed one


def run_suite():
    """This repo's test suite as a subprocess, judged by its exit code alone.
    Returns (ok, path): path is the file holding its output when it failed."""
    fd, path = tempfile.mkstemp(prefix="skillctl-update-suite-", suffix=".txt")
    with os.fdopen(fd, "w") as out:
        try:
            r = subprocess.run([sys.executable, "-m", "unittest", "discover", "-s", "tests"],
                               cwd=REPO, stdin=subprocess.DEVNULL,
                               stdout=out, stderr=subprocess.STDOUT, timeout=SUITE_TIMEOUT)
        except subprocess.TimeoutExpired:
            out.write("\nskillctl: the suite timed out after %ds\n" % SUITE_TIMEOUT)
            return False, path
    if r.returncode == 0:
        os.unlink(path)
        return True, None
    return False, path


def _update_mods(m, dry_run):
    """Refresh each listed mod's marketplace and update it to the latest,
    recording the installed version in `m`. Returns (moved, waiting, failed):
    moved is [(id, old, new)]; a mod waiting on approval is left as it is."""
    listed = manifest_mods(m)
    moved, waiting, failed = [], [], []
    if not listed:
        return moved, waiting, failed
    installed = installed_mods()
    if installed is None:
        _mod_line("error", red, "`claude plugin list` failed — mods not updated")
        return moved, waiting, sorted(listed)
    refreshed = {}  # marketplace -> whether `marketplace update` succeeded
    updated = []
    for mod_id in sorted(listed):
        if mod_id not in installed:
            if removed_here(mod_id):
                _mod_line("skipped", yellow, "%s — uninstalled here; the next sync removes "
                          "it everywhere (reinstall it to keep it)" % mod_id)
            elif mod_id in waiting_mods():
                waiting.append(mod_id)
            else:
                _mod_line("skipped", yellow, "%s — not installed here; skillctl sync "
                          "installs it" % mod_id)
            continue
        if not installed[mod_id]["enabled"]:
            # `plugin update` could re-enable it; that is the owner's call.
            _mod_line("skipped", yellow, "%s — disabled here — skipped" % mod_id)
            continue
        market = marketplace_name(mod_id)
        if dry_run:
            _mod_line("would", yellow, "%s — refresh %s and take its latest (now %s)"
                      % (mod_id, market or "?", installed[mod_id]["version"] or "?"))
            continue
        if not market:
            _mod_line("error", red, "%s — not a name@marketplace id" % mod_id)
            failed.append(mod_id)
            continue
        if market not in refreshed:
            rc, _, err = plugin_cli("marketplace", "update", market)
            refreshed[market] = rc == 0
            if rc != 0:
                _mod_line("error", red, "marketplace %s — update failed (exit %d): %s"
                          % (market, rc, err or "no detail"))
        if not refreshed[market]:
            failed.append(mod_id)
        elif approve_mod(mod_id, "update"):
            updated.append(mod_id)
        elif mod_id in waiting_mods():
            waiting.append(mod_id)
        else:
            failed.append(mod_id)
    if updated:
        after = installed_mods()
        for mod_id in updated:
            new = ((after or {}).get(mod_id) or {}).get("version")
            spec = m["mods"][mod_id]
            old = spec.get("version") if isinstance(spec.get("version"), str) else None
            if not new:
                _mod_line("error", red, "%s — updated, but its version could not be read; "
                          "skills.json keeps %s" % (mod_id, old or "no version"))
                failed.append(mod_id)
            elif new != old:
                spec["version"] = new
                moved.append((mod_id, old, new))
    return moved, waiting, failed


def cmd_update(args):
    """Every vendored skill to its upstream's latest commit and every mod to
    its marketplace's latest; lint and the test suite; then one commit,
    pushed. Run when the owner checks in. A skill that cannot be fetched is
    skipped and named, and a mod waiting on approval is left as it is; the
    rest still go through."""
    if IS_CLOUD:
        die("update commits and pushes, which cloud sessions never do; run it on a Mac")
    hold = _update_hold(repo_state(strict=True))
    if hold and not args.dry_run:
        die("not updating: %s" % hold)
    if hold:
        print(yellow("  note      ") + "a real run would refuse: %s" % hold)
    elif not args.dry_run:
        ok, why = pull_ff_only()
        if not ok:
            die("git pull --ff-only failed: %s" % why)

    m = load_manifest()
    moved_skills, skipped = [], []
    for name in sorted(m["skills"]):
        spec = m["skills"][name] or {}
        if not spec.get("origin"):
            continue
        try:
            r = vendor_one(name, spec, dry_run=args.dry_run)
        except (Exception, SystemExit) as e:
            # SystemExit: gh() dies on a rate limit, having said why on stderr.
            why = ("see the error above" if isinstance(e, SystemExit)
                   else str(e) if isinstance(e, UpstreamGone)
                   else "%s: %s" % (type(e).__name__, e))
            print(red("  skipped   ") + "%s — %s" % (name, why))
            skipped.append(name)
            continue
        if r["changed"] or r["old"] != r["new"]:
            moved_skills.append((name, r["old"], r["new"]))
    if moved_skills and not args.dry_run:
        save_manifest(m)  # before the mods, so a crash there leaves pins matching files

    moved_mods, waiting, failed = _update_mods(m, args.dry_run)
    if moved_mods:
        save_manifest(m)

    print()
    for name, old, new in moved_skills:
        print("  skill  %-28s %s -> %s" % (name, (old or "unpinned")[:7], new[:7]))
    for mod_id, old, new in moved_mods:
        print("  mod    %-28s %s -> %s" % (mod_id, old or "none", new))
    for mod_id in waiting:
        print(yellow("  waiting   ") + "%s — left at its version; approve with: "
              "skillctl approve %s" % (mod_id, mod_id))
    if skipped:
        print(red("  skipped   ") + "%s — not updated; re-run update once fixed"
              % ", ".join(skipped))
    if failed:
        print(red("  failed    ") + "%s — not updated" % ", ".join(failed))
    status = 1 if skipped or failed else 0

    if args.dry_run:
        print(bold("dry run — nothing written, pulled or committed"))
        return status
    if not moved_skills and not moved_mods:
        print(green("nothing to update"))
        return status

    print(dim("linting…"))
    if cmd_lint(args) != 0:
        print(red("lint failed") + " — changes left uncommitted in %s; nothing pushed" % REPO)
        return 1
    print(dim("running the test suite…"))
    ok, path = run_suite()
    if not ok:
        print(red("test suite failed") + " — output in %s; changes left uncommitted, "
              "nothing pushed" % path)
        return 1
    message = "Update: %d skill(s), %d mod(s)" % (len(moved_skills), len(moved_mods))
    if not commit_and_push(["skills.json", "skills"], message):
        return 1
    print(green("committed and pushed: ") + message)
    return status


def cmd_adopt(args):
    """Pull an installed-but-unmanaged skill into the repo and register it."""
    m = load_manifest()
    live = os.path.join(INSTALL_DIR, args.name)
    if not os.path.isdir(live) or os.path.islink(live):
        die("%s is not a real directory in %s" % (args.name, INSTALL_DIR))
    dest = os.path.join(SKILLS_SRC, args.name)
    if args.dry_run:
        if os.path.isdir(dest):
            subprocess.run(["git", "diff", "--no-index", "--stat", dest, live])
        else:
            print("would add %d file(s) as a new skill" % len(walk_files(live)))
        return 0
    if os.path.isdir(dest):
        shutil.rmtree(dest)
    shutil.copytree(live, dest, ignore=shutil.ignore_patterns(*IGNORE))
    spec = m["skills"].setdefault(args.name, {"origin": None})
    spec["hash"] = tree_hash(dest)
    save_manifest(m)
    print(green("adopted ") + "%s into skills/ and registered it" % args.name)
    print(dim("  run `skillctl sync` to replace the copy with a symlink"))
    return 0


def read_frontmatter(path):
    """Minimal YAML-frontmatter reader — enough for name/description, no deps."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError as e:
        return None, str(e)
    if not text.startswith("---"):
        return None, "no frontmatter block"
    end = text.find("\n---", 3)
    if end < 0:
        return None, "unterminated frontmatter block"
    return text[3:end], None


def fm_field(block, key):
    """Value of `key`, handling plain scalars and folded/literal (>, |) blocks."""
    m = re.search(r'^%s:\s*(.*)$' % re.escape(key), block, re.M)
    if not m:
        return None
    value = m.group(1).strip()
    if value in (">", "|", ">-", "|-", ">+", "|+", ""):
        lines, started = [], False
        for line in block[m.end():].split("\n"):
            if not started and not line.strip():
                continue
            if line[:1] in (" ", "\t"):
                lines.append(line.strip())
                started = True
            elif started or line.strip():
                break
        return " ".join(lines).strip()
    return value.strip().strip('"\'')


_FENCE = re.compile(r'\s*(```|~~~)')
_MD_LINK = re.compile(r'\[[^\]]*\]\(\s*([^)\s]+?)\s*\)')
# Anything with a scheme, a protocol-relative or absolute path, or a bare
# anchor points somewhere we cannot check.
_NOT_A_FILE = re.compile(r'^(?:[a-z][a-z0-9+.-]*:|//|#|/)', re.I)


def strip_code_fences(text):
    """Drop fenced blocks. Code samples are full of things that look like
    markdown links — `vector[i](int)` in the C++ reference, and the skill
    layouts quoted as examples in writing-skills — and none are real links."""
    out, fence = [], None
    for line in text.splitlines():
        m = _FENCE.match(line)
        if m:
            if fence is None:
                fence = m.group(1)
            elif line.strip().startswith(fence):
                fence = None
            continue
        if fence is None:
            out.append(line)
    return "\n".join(out)


def dangling_links(root):
    """Relative markdown links in a skill whose targets were not vendored.

    This is the check that would have caught `code-review-skill` shipping with
    include globs narrower than what its SKILL.md referenced: three links into
    assets/ and scripts/, neither of which was vendored, and `lint` passed it
    clean. Resolution is against SKILLS_SRC rather than the skill directory,
    because installed skills sit side by side in ~/.claude/skills and several
    legitimately link to each other (writing-skills -> using-superpowers).
    """
    out = []
    for rel, ap in sorted(walk_files(root).items()):
        if not rel.endswith(".md"):
            continue
        try:
            with open(ap, errors="ignore") as f:
                body = strip_code_fences(f.read())
        except OSError:
            continue
        base = os.path.dirname(ap)
        for target in _MD_LINK.findall(body):
            if _NOT_A_FILE.match(target):
                continue
            resolved = os.path.normpath(os.path.join(base, target.split("#")[0]))
            # Links reaching outside skills/ are relative to the upstream repo
            # and never survive vendoring — caveman's README points at its own
            # repo root. Not a defect in the vendored copy.
            if not resolved.startswith(SKILLS_SRC + os.sep):
                continue
            if not os.path.exists(resolved):
                out.append((rel, target))
    return out


def cmd_lint(args):
    """Catch problems that stop a skill registering or triggering correctly.

    Vendoring is the usual way these appear: upstream renames a skill and the
    directory silently stops matching the declared name.
    """
    m = load_manifest()
    errors, warnings = [], []

    for name in sorted(m["skills"]):
        d = os.path.join(SKILLS_SRC, name)
        if not os.path.isdir(d):
            errors.append((name, "declared in skills.json but missing from skills/"))
            continue
        p = os.path.join(d, "SKILL.md")
        if not os.path.isfile(p):
            errors.append((name, "no SKILL.md — the client cannot register it"))
            continue
        block, err = read_frontmatter(p)
        if block is None:
            errors.append((name, "SKILL.md %s" % err))
            continue
        declared = fm_field(block, "name")
        desc = fm_field(block, "description")
        if not declared:
            errors.append((name, "frontmatter has no `name`"))
        elif declared != name:
            errors.append((name, "frontmatter name is '%s' but the directory is '%s' — "
                                 "rename the directory to match, or the manifest key"
                           % (declared, name)))
        if not desc:
            errors.append((name, "frontmatter has no `description` — nothing to trigger on"))
        else:
            if len(desc) < 40:
                warnings.append((name, "description is %d chars; too terse to trigger reliably"
                                 % len(desc)))
            if len(desc) > 700:
                warnings.append((name, "description is %d chars; very long descriptions "
                                       "dilute the trigger" % len(desc)))

        # A dangling link in SKILL.md is a broken skill: it is the file the
        # client registers and the agent reads first. Elsewhere it is a defect
        # worth knowing about but not one that stops the skill working.
        for rel, target in dangling_links(d):
            where = "SKILL.md" if rel == "SKILL.md" else rel
            msg = "%s links to `%s`, which was not vendored" % (where, target)
            (errors if rel == "SKILL.md" else warnings).append((name, msg))

    if os.path.isdir(SKILLS_SRC):
        for d in sorted(os.listdir(SKILLS_SRC)):
            if os.path.isdir(os.path.join(SKILLS_SRC, d)) and d not in m["skills"]:
                errors.append((d, "present in skills/ but not declared in skills.json"))

    for n, msg in errors:
        print("  %-9s %-28s %s" % (red("error"), n, msg))
    for n, msg in warnings:
        print("  %-9s %-28s %s" % (yellow("warn"), n, msg))
    print()
    if errors:
        print(bold("%d error(s), %d warning(s)" % (len(errors), len(warnings))))
    elif warnings:
        print(green("no errors") + ", %d warning(s)" % len(warnings))
    else:
        print(green("all %d skills well-formed" % len(m["skills"])))
    return 1 if errors else 0


EVAL_DIR = os.path.join(REPO, "eval")


def wilson(k, n, z=1.96):
    """95% confidence interval for a proportion. Small n gives wide bounds —
    that is the point: it stops a lucky run reading as a real improvement."""
    if n == 0:
        return 0.0, 0.0
    import math
    p = k / n
    d = 1 + z * z / n
    centre = (p + z * z / (2 * n)) / d
    margin = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / d
    return max(0.0, centre - margin), min(1.0, centre + margin)


def score(hits, n, baseline):
    """One measured axis: rate, interval, and how it stands against baseline.

    Only a baseline outside the interval is a real change — with 5 reps the
    interval is wide, and calling every wobble a regression would train us to
    ignore the column.
    """
    rate = hits / n if n else 0.0
    lo, hi = wilson(hits, n)
    verdict = None
    # n == 0 means every rep errored before producing a transcript. wilson()
    # returns (0.0, 0.0) there, which any non-zero baseline sits above — so
    # without this guard a wholly failed run renders as a confident
    # "REGRESSED", which is how a broken --settings path once looked like a
    # measurement. No runs, no verdict.
    if baseline is not None and n:
        if baseline < lo:
            verdict = "improved"
        elif baseline > hi:
            verdict = "regressed"
        else:
            verdict = "noise"
    return {"hits": hits, "n": n, "rate": rate, "ci": [lo, hi],
            "baseline": baseline, "verdict": verdict}


def eval_exit_code(rows):
    """Non-zero when a run regressed *or* when it never really ran.

    Suppressing the bogus verdict above must not turn a total failure into a
    green exit: an unscored case is not a passing case.
    """
    for _, sc in rows:
        if sc["verdict"] == "regressed" or sc["n"] == 0:
            return 1
    return 0


def timeline(stream_lines):
    """Every assistant event, in order, flattened to one comparable shape.

    Activation only ever needed the Skill calls. Compliance needs the shape of
    the whole session, so this keeps what a predicate can match on: which tool
    ran, and the one string that identifies what it ran against.
    """
    parsed = []
    for line in stream_lines:
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            parsed.append(json.loads(line))
        except ValueError:
            continue

    # A refused call still emits a tool_use block, so the request alone proves
    # nothing: a run can ask to run the suite, be refused, and still look like
    # it verified. Refusal is reported in the result event, and that is the
    # only thing that means a call did not happen — a `tool_result` marked
    # is_error covers a suite that ran and reported failures, which for a
    # skill demanding verification is the compliant outcome, not a missing step.
    denied = set()
    for ev in parsed:
        if ev.get("type") == "result":
            for d in ev.get("permission_denials") or []:
                denied.add(d.get("tool_use_id"))

    events = []
    for ev in parsed:
        if ev.get("type") != "assistant":
            continue
        for block in (ev.get("message") or {}).get("content") or []:
            if not isinstance(block, dict):
                continue
            if block.get("type") == "tool_use":
                inp = block.get("input") or {}
                events.append({"kind": "tool", "tool": block.get("name"),
                               "text": inp.get("command") or inp.get("file_path") or "",
                               "ok": block.get("id") not in denied})
            elif block.get("type") == "text":
                events.append({"kind": "text", "tool": None,
                               "text": block.get("text") or "", "ok": None})
    return events


def _matches(event, matcher, idx=None, final_idx=None):
    """One timeline event against one matcher. Absent fields do not constrain.

    `kind: final` is the assistant's closing message — the last prose it
    wrote. Skills that gate a *claim* ("only then say it passes") are really
    constraining what happened before that message, so it needs to be
    addressable as a step rather than guessed at from success words, which
    the skills themselves say is hopeless because paraphrases count.
    """
    # A call the harness refused did not happen — it can neither satisfy a
    # step nor constitute a violation. Unknown (no result seen) stays lenient.
    if event.get("ok") is False:
        return False
    kind = matcher.get("kind")
    if kind == "final":
        if idx != final_idx:
            return False
    elif kind is not None and event["kind"] != kind:
        return False
    if "tool" in matcher and not re.search(matcher["tool"], event["tool"] or ""):
        return False
    if "text" in matcher and not re.search(matcher["text"], event["text"]):
        return False
    return True


def _final_index(events):
    """Index of the assistant's closing prose, or None if it never spoke."""
    for i in range(len(events) - 1, -1, -1):
        if events[i]["kind"] == "text":
            return i
    return None


def complies(events, spec):
    """Did this run do the thing the skill exists to make it do?

    `sequence` is matched as a subsequence, not a contiguous run: a skill
    cares that the test ran before the claim, not that nothing happened in
    between.
    """
    steps = spec.get("sequence") or []
    forbidden = spec.get("forbid_before") or []
    final_idx = _final_index(events)
    i = 0
    for idx, event in enumerate(events):
        # Anything forbidden that happens before the sequence opens is the
        # violation itself: editing before running the tests is the failure
        # systematic-debugging exists to prevent, however the run ends.
        if i == 0 and any(_matches(event, m, idx, final_idx) for m in forbidden):
            return False
        if i < len(steps) and _matches(event, steps[i], idx, final_idx):
            i += 1
    return i == len(steps)


def skills_invoked(stream_lines):
    """Extract every skill name invoked, from a stream-json transcript.

    Ground truth rather than self-report: the CLI emits a tool_use block for
    each Skill call, including ones made inside subagents.
    """
    found = []
    for line in stream_lines:
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if ev.get("type") != "assistant":
            continue
        for block in (ev.get("message") or {}).get("content") or []:
            if not isinstance(block, dict) or block.get("type") != "tool_use":
                continue
            if block.get("name") != "Skill":
                continue
            inp = block.get("input") or {}
            name = inp.get("skill") or inp.get("name") or inp.get("command")
            found.append(name if name else "<unnamed>")
    return found


# acceptEdits lets a run edit files but refuses every Bash call, so without an
# allowlist no eval run can execute the suite it is being scored on — it asks,
# is refused, and the transcript still shows the request. Scoped to the test
# runner on purpose: anything else a run reaches for is still refused, and
# shows up as a denial rather than silently succeeding.
EVAL_ALLOWED_TOOLS = "Bash(python3:*)"


def resolve_settings(settings, cwd=None):
    """Make `--settings` survive the chdir into a per-run temp directory.

    Accepts what the CLI accepts: a path, or a literal JSON string. A literal
    is passed through untouched — running abspath over it would turn valid
    JSON into a nonexistent filename and fail every rep.
    """
    if not settings:
        return None
    if settings.lstrip().startswith("{"):
        return settings
    return os.path.join(cwd or os.getcwd(), settings) if not os.path.isabs(settings) \
        else settings


def eval_command(prompt, permission_mode, settings=None):
    """The argv one headless eval run is launched with.

    `settings` is forwarded to `claude --settings`, which loads *additional*
    settings on top of the user's own rather than replacing them — so a run
    with it differs from a run without it by exactly that file's contents.
    That is what makes a hook measurable: it reaches the eval sessions and
    nothing else on the machine, and `~/.claude/settings.json` is untouched.

    Omitted entirely when nothing was asked for. The baselines recorded in
    OPEN.md were measured with no `--settings`, and passing an empty one
    anyway would quietly make later runs incomparable to them.
    """
    cmd = ["claude", "-p", prompt, "--output-format", "stream-json", "--verbose",
           "--permission-mode", permission_mode,
           "--allowedTools", EVAL_ALLOWED_TOOLS]
    if settings:
        cmd += ["--settings", settings]
    return cmd


def run_one(prompt, workspace, permission_mode, timeout, settings=None):
    """One headless Claude run. Returns (skills_invoked, timeline, error).

    The timeline was always in this transcript; until compliance scoring it
    was parsed for Skill calls and thrown away.
    """
    tmp = tempfile.mkdtemp(prefix="skillctl-eval-")
    try:
        cwd = tmp
        if workspace:
            src = os.path.join(EVAL_DIR, "workspaces", workspace)
            if not os.path.isdir(src):
                return [], [], "no such workspace: %s" % workspace
            cwd = os.path.join(tmp, workspace)
            shutil.copytree(src, cwd)
            subprocess.run(["git", "init", "-q"], cwd=cwd, capture_output=True)
            subprocess.run(["git", "add", "-A"], cwd=cwd, capture_output=True)
            subprocess.run(["git", "-c", "user.email=eval@local", "-c", "user.name=eval",
                            "commit", "-qm", "initial"], cwd=cwd, capture_output=True)
        cmd = eval_command(prompt, permission_mode, settings)
        # Each run starts a session; without this every rep would pull and sync.
        env = {**os.environ, "SKILLCTL_NO_AUTOSYNC": "1"}
        try:
            proc = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout,
                                  env=env)
        except FileNotFoundError:
            return [], [], "the `claude` CLI is not on PATH"
        except subprocess.TimeoutExpired:
            return [], [], "timed out after %ds" % timeout
        lines = proc.stdout.splitlines()
        blob = proc.stdout + proc.stderr
        if "Please run /login" in blob or "authentication_failed" in blob:
            return [], [], "the `claude` CLI is not logged in — run `claude` and /login first"
        if not lines:
            return [], [], (proc.stderr.strip().splitlines() or ["no output"])[0][:120]
        return skills_invoked(lines), timeline(lines), None
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def cmd_eval(args):
    """Measure whether prompts trigger the right skills — and whether it mattered.

    Activation is stochastic — a single run cannot tell 'never' from
    'sometimes'. Repetitions plus a confidence interval can.

    Firing is only half the question. A skill that activates and changes
    nothing has not done its job, so cases carrying a `comply` block are also
    scored on what the run actually did: the ordered tool calls, checked
    against the behaviour the skill exists to produce. That axis is scored
    over every rep, not only the ones that fired — a run that verified before
    claiming is compliant whether it got there via the skill or on its own,
    and the gap between the two columns is what says whether the skill earns
    its place.
    """
    path = args.fixtures or os.path.join(EVAL_DIR, "fixtures.json")
    try:
        with open(path) as f:
            fx = json.load(f)
    except (OSError, ValueError) as e:
        die("cannot read fixtures %s: %s" % (path, e))

    cases = [c for c in fx.get("cases", [])
             if not args.filter or args.filter in c["id"]]
    if not cases:
        die("no cases matched %r" % args.filter)
    reps = args.reps or fx.get("reps", 5)
    total_runs = len(cases) * reps

    print(bold("skillctl eval") + "  %d case(s) x %d rep(s) = %d headless Claude run(s)"
          % (len(cases), reps, total_runs))
    print(dim("  each run is a real session and costs tokens; ^C to abort"))
    print()

    settings = resolve_settings(args.settings)

    results, failed = [], 0
    for case in cases:
        fired = 0
        complied = 0
        ran = 0
        seen = {}
        spec = case.get("comply")
        for i in range(reps):
            got, events, err = run_one(case["prompt"], case.get("workspace"),
                                       args.permission_mode, args.timeout,
                                       settings)
            if err:
                failed += 1
                print("  %-9s %-18s rep %d: %s" % (red("error"), case["id"], i + 1, err))
                if "not logged in" in err or "not on PATH" in err:
                    die("cannot run evals until that is fixed")
                continue
            ran += 1
            hit = any(s in case["expect"] for s in got)
            fired += 1 if hit else 0
            ok = complies(events, spec) if spec else None
            complied += 1 if ok else 0
            for s in got:
                seen[s] = seen.get(s, 0) + 1
            comply_txt = "" if ok is None else (
                "  " + (green("complied") if ok else red("violated")))
            print("  %-9s %-18s rep %d/%d  %s%s" % (
                green("fired") if hit else dim("  -  "), case["id"], i + 1, reps,
                dim(", ".join(got) if got else "no skill"), comply_txt))
        act = score(fired, ran, case.get("baseline"))
        comp = score(complied, ran, case.get("comply_baseline")) if spec else None
        results.append({"id": case["id"], "expect": case["expect"],
                        "activation": act, "compliance": comp,
                        "all_skills": seen})
        print()

    def verdict_text(sc):
        if sc["n"] == 0:
            return red("no runs — not scored")
        if sc["verdict"] is None:
            return dim("n/a")
        delta = (sc["rate"] - sc["baseline"]) * 100
        if sc["verdict"] == "improved":
            return green("improved (+%.0f pts)" % delta)
        if sc["verdict"] == "regressed":
            return red("REGRESSED (%.0f pts)" % delta)
        return dim("%+.0f pts (within noise)" % delta)

    def table(heading, hits_label, rows):
        print(bold("%-20s %-7s %-7s %-18s %s"
                   % ("case", hits_label, "rate", "95% CI", "vs baseline")))
        print("-" * 74)
        for rid, sc in rows:
            ci = "[%3.0f%%, %3.0f%%]" % (sc["ci"][0] * 100, sc["ci"][1] * 100)
            print("%-20s %-7s %-7s %-18s %s" % (
                rid, "%d/%d" % (sc["hits"], sc["n"]),
                "%.0f%%" % (sc["rate"] * 100), ci, verdict_text(sc)))
        print()

    def overall(label, rows):
        hits = sum(sc["hits"] for _, sc in rows)
        n = sum(sc["n"] for _, sc in rows)
        lo, hi = wilson(hits, n)
        print(bold("%-11s" % label) + "%d/%d = %.0f%%  [%.0f%%, %.0f%%]"
              % (hits, n, hits / n * 100 if n else 0, lo * 100, hi * 100))

    activation = [(r["id"], r["activation"]) for r in results]
    compliance = [(r["id"], r["compliance"]) for r in results if r["compliance"]]

    print(bold("activation") + dim("  — did the right skill fire?"))
    table("activation", "fired", activation)
    if compliance:
        print(bold("compliance") + dim("  — did the run do the thing anyway?"))
        table("compliance", "ok", compliance)

    exit_code = eval_exit_code(activation + compliance)
    overall("activation", activation)
    if compliance:
        overall("compliance", compliance)
        scored = {rid for rid, _ in compliance}
        skipped = [r["id"] for r in results if r["id"] not in scored]
        if skipped:
            print(dim("  no comply block, not scored: %s" % ", ".join(skipped)))
    if failed:
        print(yellow("  %d run(s) errored and were excluded" % failed))
    if reps < 10:
        print(dim("  note: %d reps gives wide intervals; ~11 are needed to separate "
                  "a 20%% skill from an 80%% one" % reps))
    if args.save:
        with open(args.save, "w") as f:
            json.dump({"reps": reps, "results": results}, f, indent=2)
        print(dim("  wrote %s" % args.save))
    return exit_code


def cmd_seal(args):
    """Recompute every hash from the current repo contents."""
    m = load_manifest()
    for name, spec in m["skills"].items():
        src = os.path.join(SKILLS_SRC, name)
        if os.path.isdir(src):
            spec["hash"] = tree_hash(src)
    save_manifest(m)
    print(green("hashes refreshed for %d skill(s)" % len(m["skills"])))
    return 0


# ------------------------------------------------------------------ publish ---

# GitHub's noreply form: commits still attribute to the account that owns the
# mirror, without putting a real address in a public repo. Override with a
# top-level "mirror_identity" in skills.json.
DEFAULT_MIRROR_IDENTITY = {
    "name": "akashparmar93",
    "email": "akashparmar93@users.noreply.github.com",
}

# Publishing crosses a private -> public boundary, and it has gone wrong before:
# the initial commit vendored an `impeccable` that hardcoded C:/Users/<name>.
# Once a GitHub Action publishes automatically there is no human reading the
# diff, so the scan below is the only thing left standing at that boundary.
#
# Patterns are structural on purpose. Listing the actual private strings would
# put them in bin/skillctl, which is itself published — the guard would leak
# exactly what it guards.
SAFE_EMAIL_DOMAINS = (
    "example.com", "example.org", "example.net", "test.com", "test.local",
    "users.noreply.github.com", "noreply.github.com", "anthropic.com",
)

LEAK_PATTERNS = [
    ("email address", re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}")),
    ("home directory path", re.compile(r"(?:/Users/|/home/|C:[\\/]Users[\\/])[A-Za-z0-9._-]+")),
    ("private key block", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY")),
    ("credential", re.compile(r"(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}"
                              r"|github_pat_[A-Za-z0-9_]{20,}"
                              r"|sk-ant-[A-Za-z0-9-]{20,}"
                              r"|AKIA[0-9A-Z]{16}")),
]

# Generic placeholders that are not leaks: the component after /Users/ etc. is
# either elided ("/Users/.../hook.mjs", as impeccable's comments write it) or a
# stand-in name no real machine carries.
SAFE_PATH_COMPONENTS = frozenset(
    ["user", "you", "username", "youruser", "yourname", "me", "name", "home"])


def mirror_slug(url):
    """owner/repo from a mirror URL, in either https or ssh form.

    The workflow passes the ssh form so its deploy key is used, so this cannot
    just strip an https prefix — doing that put a whole `git@github.com:...`
    URL into the generated README, where the leak scan then flagged it as an
    email address and failed the first CI run.
    """
    m = re.search(r"[:/]([^/:]+/[^/:]+?)(?:\.git)?/?$", url)
    return m.group(1) if m else url


def _placeholder_path(hit):
    """True when a matched path names nobody — a stand-in, not a real account."""
    comp = re.split(r"[\\/]", hit)[-1]
    if not comp or comp in ("Users", "home"):
        return True
    if re.fullmatch(r"[.<>{}$_-]+", comp):        # /Users/... or C:\Users\<you>
        return True
    return comp.lower() in SAFE_PATH_COMPONENTS


def scan_for_leaks(root):
    """Find personal data in a tree about to be published. Returns findings."""
    found = []
    for rel, ap in sorted(walk_files(root).items()):
        try:
            with open(ap, "r", errors="ignore") as f:
                text = f.read()
        except OSError:
            continue
        for label, pat in LEAK_PATTERNS:
            for hit in set(pat.findall(text)):
                if label == "email address":
                    if hit.rsplit("@", 1)[-1].lower() in SAFE_EMAIL_DOMAINS:
                        continue
                    # `git@github.com:owner/repo` is an ssh remote, not a
                    # person. The mirror URL itself is written in that form.
                    if hit.lower().startswith("git@"):
                        continue
                elif label == "home directory path":
                    if _placeholder_path(hit):
                        continue
                found.append((rel, label, hit))
    return found


MIRROR_README = """# claude-skills-dist

Public, generated distribution of my Claude Code skills. **Do not edit or open
pull requests here** — this repo is overwritten wholesale by `skillctl publish`
from a private source repo, so any change made here is lost on the next publish.

It exists for one reason: a Claude Code cloud session working in some *other*
repo cannot clone a private one (the session's git credentials are scoped to
the repos attached to that session), so the skills have to be reachable
without authentication.

## What a cloud session does with this

```bash
git clone --depth 1 https://github.com/%(mirror_repo)s ~/.claude/claude-skills
~/.claude/claude-skills/bin/cloud-setup.sh
```

`cloud-setup.sh` registers `bin/cloud-sync.sh` as a user-level SessionStart
hook, which re-pulls this repo and re-runs `skillctl sync` at the start of
every session. Skills installed that way are registered in the same session.

## Contents

`skills/` — %(count)d skills, `skills.json` — the manifest they are pinned by,
`CLAUDE.md` — the routing table that makes them fire, `bin/skillctl` — the
sync tool, `bin/cloud-*.sh` — the cloud bootstrap and hook,
`hooks/` — three hooks that `skillctl sync` registers: two warn-only ones
(instruction-file size, context size) and `session-sync.py`, which pulls and
syncs at the start of every session on a Mac and does nothing in cloud.

Most of the skills are vendored from public upstreams; `skills.json` records
each one's origin repo and pinned commit. Credit belongs to their authors.
"""


def _publish_tree(dest):
    """Copy the publishable subset of this repo into dest."""
    for rel in PUBLISH_PATHS:
        src = os.path.join(REPO, rel)
        dst = os.path.join(dest, rel)
        if not os.path.exists(src):
            die("publish set references %s, which does not exist" % rel)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        if os.path.isdir(src):
            shutil.copytree(src, dst,
                            ignore=shutil.ignore_patterns(*IGNORE))
        else:
            shutil.copy2(src, dst)


def cmd_publish(args):
    """Push the skills-only subset of this repo to its public mirror.

    The mirror gets a fresh history — one commit per publish, naming the
    private commit it came from. Nothing from this repo's own history travels,
    which is the point: the initial commit here hardcoded a Windows username,
    and OPEN.md carries an email address and the name of a private repo.
    """
    m = load_manifest()
    mirror = args.mirror or m.get("mirror")
    if not mirror:
        die("no mirror configured — add a top-level \"mirror\" to skills.json "
            "or pass --mirror")

    dirty = git("status", "--porcelain")
    if dirty and not args.allow_dirty:
        die("working tree is dirty — commit first, so the mirror names a real "
            "commit (or pass --allow-dirty)")
    head = git("rev-parse", "HEAD") or "unknown"

    print(bold("mirror  ") + mirror)
    print(bold("source  ") + head[:12] + dim("  (%d skills)" % len(m["skills"])))
    print()

    with tempfile.TemporaryDirectory() as tmp:
        clone = os.path.join(tmp, "mirror")
        r = subprocess.run(["git", "clone", "--quiet", "--depth", "1", mirror, clone],
                           capture_output=True, text=True)
        fresh = r.returncode != 0
        if fresh:
            # An empty repo cannot be cloned; start one and let the push create main.
            print(dim("  mirror is empty or unreachable — initialising a new history"))
            os.makedirs(clone)
            subprocess.run(["git", "init", "--quiet", "-b", "main", clone], check=True)
            subprocess.run(["git", "-C", clone, "remote", "add", "origin", mirror], check=True)
        else:
            # Wipe tracked content so a deleted skill really disappears.
            for entry in os.listdir(clone):
                if entry == ".git":
                    continue
                p = os.path.join(clone, entry)
                shutil.rmtree(p) if os.path.isdir(p) else os.remove(p)

        _publish_tree(clone)
        with open(os.path.join(clone, "README.md"), "w") as f:
            f.write(MIRROR_README % {
                "mirror_repo": mirror_slug(mirror),
                "count": len(m["skills"]),
            })

        leaks = [] if args.skip_leak_scan else scan_for_leaks(clone)
        if leaks:
            print(red("  refusing to publish — personal data in the tree:"))
            for rel, label, hit in leaks[:20]:
                print(red("    %s" % rel) + dim("  %s: " % label) + hit)
            if len(leaks) > 20:
                print(dim("    … and %d more" % (len(leaks) - 20)))
            die("%d finding(s). Fix them, or re-run with --skip-leak-scan if every "
                "one is a\n  false positive — this repo is private and the mirror "
                "is not." % len(leaks))
        if args.skip_leak_scan:
            print(yellow("  leak scan skipped"))

        subprocess.run(["git", "-C", clone, "add", "-A"], check=True)
        staged = subprocess.run(["git", "-C", clone, "diff", "--cached", "--stat"],
                                capture_output=True, text=True).stdout.strip()
        if not staged:
            print(green("mirror already matches this commit — nothing to publish"))
            return 0
        print(dim("\n".join("  " + l for l in staged.splitlines()[-12:])))
        print()

        if args.dry_run:
            print(bold("dry run — nothing pushed"))
            return 0

        msg = args.message or "publish: %s" % head[:12]
        # Pin the identity rather than inheriting the device's. Otherwise the
        # publishing machine's git config decides what lands in a *public*
        # repo, and a normally-configured device would stamp a real email
        # address onto every mirror commit — the exact leak the mirror avoids.
        ident = m.get("mirror_identity", DEFAULT_MIRROR_IDENTITY)
        # Via the environment, not `-c user.email`: GIT_AUTHOR_* / GIT_COMMITTER_*
        # take precedence over config, so a device that exports them would still
        # leak its real address through the config route. Verified 2026-08-21.
        env = dict(os.environ,
                   GIT_AUTHOR_NAME=ident["name"], GIT_AUTHOR_EMAIL=ident["email"],
                   GIT_COMMITTER_NAME=ident["name"], GIT_COMMITTER_EMAIL=ident["email"])
        subprocess.run(["git", "-C", clone, "commit", "--quiet", "--no-gpg-sign",
                        "-m", msg], check=True, env=env)
        push = subprocess.run(["git", "-C", clone, "push", "--quiet", "origin", "main"],
                              capture_output=True, text=True)
        if push.returncode != 0:
            die("push to mirror failed:\n%s" % (push.stderr.strip() or push.stdout.strip()))

    print(green("published to %s" % mirror))
    print(dim("  cloud sessions pick this up on their next session start."))
    return 0


def main():
    p = argparse.ArgumentParser(prog="skillctl", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("status", help="where this device stands")
    s.add_argument("--json", action="store_true")
    s.add_argument("--no-fetch", action="store_true",
                   help="skip the git fetch (offline; behind-count may be stale)")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("sync", help="make ~/.claude/skills match the manifest")
    s.add_argument("--dry-run", action="store_true")
    s.add_argument("--force", action="store_true", help="replace drifted real directories")
    s.set_defaults(fn=cmd_sync)

    s = sub.add_parser("remove", help="remove a skill or mod everywhere (commits and pushes)")
    s.add_argument("name", help="a skill name or a mod id (name@marketplace)")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(fn=cmd_remove)

    s = sub.add_parser("update", help="every skill and mod to upstream latest; lint, test, "
                                      "commit and push")
    s.add_argument("--dry-run", action="store_true",
                   help="say what would move; write, pull and commit nothing")
    s.set_defaults(fn=cmd_update)

    s = sub.add_parser("approve", help="approve the command a mod is waiting on, then "
                                       "install or update it")
    s.add_argument("id", help="the mod's name@marketplace id")
    s.add_argument("--accept", metavar="SHA256",
                   help="approve without a prompt: the sha256 of the command shown")
    s.set_defaults(fn=cmd_approve)

    s = sub.add_parser("check", help="which vendored skills have upstream updates")
    s.add_argument("name", nargs="?")
    s.add_argument("--files", type=int, default=5, help="how many changed files to list")
    s.set_defaults(fn=cmd_check)

    s = sub.add_parser("diff", help="show what changed upstream since the pin")
    s.add_argument("name")
    s.add_argument("--stat", action="store_true")
    s.set_defaults(fn=cmd_diff)

    s = sub.add_parser("vendor", help="pull upstream in and re-pin")
    s.add_argument("name", nargs="?")
    s.add_argument("--all", action="store_true")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(fn=cmd_vendor)

    s = sub.add_parser("adopt", help="bring an unmanaged local skill into the repo")
    s.add_argument("name")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(fn=cmd_adopt)

    s = sub.add_parser("lint", help="check every skill is well-formed enough to register")
    s.set_defaults(fn=cmd_lint)

    s = sub.add_parser("eval", help="measure how often prompts actually trigger their skills")
    s.add_argument("--reps", type=int, help="repetitions per case (default: from fixtures)")
    s.add_argument("--filter", help="only run cases whose id contains this")
    s.add_argument("--fixtures", help="path to a fixtures file")
    s.add_argument("--permission-mode", default="acceptEdits",
                   help="passed to `claude -p` (default: acceptEdits)")
    s.add_argument("--timeout", type=int, default=600, help="per-run timeout in seconds")
    s.add_argument("--save", help="write results as JSON to this path")
    s.add_argument("--settings", help="extra settings JSON (file or literal) for "
                                      "the eval sessions only; merges on top of "
                                      "your own, leaving ~/.claude untouched")
    s.set_defaults(fn=cmd_eval)

    s = sub.add_parser("publish", help="push the skills-only subset to the public mirror")
    s.add_argument("--mirror", help="override the mirror URL from skills.json")
    s.add_argument("--message", help="commit message for the mirror")
    s.add_argument("--dry-run", action="store_true")
    s.add_argument("--allow-dirty", action="store_true",
                   help="publish even though this repo has uncommitted changes")
    s.add_argument("--skip-leak-scan", action="store_true",
                   help="publish despite the personal-data scan (last resort)")
    s.set_defaults(fn=cmd_publish)

    s = sub.add_parser("seal", help="recompute manifest hashes from repo contents")
    s.set_defaults(fn=cmd_seal)

    args = p.parse_args()
    if not getattr(args, "fn", None):
        p.print_help()
        return 0
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
